            "{'_id': ObjectId('573a13cdf29313caabd83c2f'), 'plot': \"Colin Clark, an employee of Sir Laurence Olivier's, documents the tense interaction between Olivier and Marilyn Monroe during the production of The Prince and the Showgirl (1957).\", 'genres': ['Biography', 'Drama'], 'runtime': 99, 'metacritic': 65, 'rated': 'R', 'cast': ['Michelle Williams', 'Eddie Redmayne', 'Julia Ormond', 'Kenneth Branagh'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTYzODYwOTIzOV5BMl5BanBnXkFtZTcwODE2NjAwNw@@._V1_SY1000_SX677_AL_.jpg', 'title': 'My Week with Marilyn', 'fullplot': \"Sir Laurence Olivier is making a movie in London. Young Colin Clark, an eager film student, wants to be involved and he navigates himself a job on the set. When film star Marilyn Monroe arrives for the start of shooting, all of London is excited to see the blonde bombshell, while Olivier is struggling to meet her many demands and acting ineptness, and Colin is intrigued by her. Colin's intrigue is met when Marilyn invites him into her inner world where she struggles with her fame, her beauty and her desire to be a great actress.\", 'languages': ['English', 'French'], 'released': datetime.datetime(2011, 12, 23, 0, 0), 'directors': ['Simon Curtis'], 'writers': ['Adrian Hodges (screenplay)', 'Colin Clark (books)'], 'awards': {'wins': 24, 'nominations': 54, 'text': 'Nominated for 2 Oscars. Another 22 wins & 54 nominations.'}, 'lastupdated': '2015-09-07 00:55:29.140000000', 'year': 2011, 'imdb': {'rating': 7.0, 'votes': 67686, 'id': 1655420}, 'countries': ['UK', 'USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cdf29313caabd83c35'), 'plot': 'A silent movie star meets a young dancer, but the arrival of talking pictures sends their careers in opposite directions.', 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 100, 'metacritic': 89, 'rated': 'PG-13', 'cast': ['Jean Dujardin', 'Bèrènice Bejo', 'John Goodman', 'James Cromwell'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMDUyZWU5N2UtOWFlMy00MTI0LTk0ZDYtMzFhNjljODBhZDA5XkEyXkFqcGdeQXVyNzA4ODc3ODU@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Artist', 'fullplot': 'Outside a movie premiere, enthusiastic fan Peppy Miller literally bumps into the swashbuckling hero of the silent film, George Valentin. The star reacts graciously and Peppy plants a kiss on his cheek as they are surrounded by photographers. The headlines demand: \"Who\\'s That Girl?\" and Peppy is inspired to audition for a dancing bit-part at the studio. However as Peppy slowly rises through the industry, the introduction of talking-pictures turns Valentin\\'s world upside-down.', 'languages': ['English', 'French'], 'released': datetime.datetime(2012, 1, 20, 0, 0), 'directors': ['Michel Hazanavicius'], 'writers': ['Michel Hazanavicius'], 'awards': {'wins': 161, 'nominations': 152, 'text': 'Won 5 Oscars. Another 156 wins & 152 nominations.'}, 'lastupdated': '2015-08-19 00:06:14.890000000', 'year': 2011, 'imdb': {'rating': 8.0, 'votes': 175000, 'id': 1655442}, 'countries': ['France'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cdf29313caabd83ca3'), 'plot': 'A French journalist in Afghanistan is kidnapped by the Taliban.', 'genres': ['Action', 'Drama', 'War'], 'runtime': 109, 'metacritic': 37, 'rated': 'R', 'cast': ['Diane Kruger', 'Djimon Hounsou', 'Benoèt Magimel', 'Denis Mènochet'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY4NTA5NjA1Ml5BMl5BanBnXkFtZTcwMDM3NDA1OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Special Forces', 'fullplot': \"In Afghanistan, French journalist Elsa and her colleague Amen are covering the story of Maina, a woman sold to a man when she was a child. Taliban leader Ahmed Zaief abducts Elsa and Amen and tries to force them to read a message to Western governments. The French president sends six Special Force to rescue Elsa who's hidden in a fortress in Pakistan. The team composed of Commander Kovax, Tic-Tac, Lucas, the sniper Elias, Victor and Marius release Elsa and Amen from their imprisonment but lose their radios. Now the group needs to cross the inhospitable land to save their lives with the Taliban chasing them.\", 'languages': ['French', 'English'], 'released': datetime.datetime(2011, 11, 2, 0, 0), 'directors': ['Stèphane Rybojad'], 'writers': ['Stèphane Rybojad (adaptation)', 'Michael Cooper (adaptation)', 'Emmanuelle Collomp (collaboration)', 'Stèphane Rybojad'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-06 00:04:20.010000000', 'year': 2011, 'imdb': {'rating': 6.3, 'votes': 13872, 'id': 1656192}, 'countries': ['France'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13cdf29313caabd83b80'), 'plot': \"A look at the late '60s and early '70s rock band The Doors, including rare exclusive footage.\", 'genres': ['Documentary', 'Music'], 'runtime': 86, 'metacritic': 55, 'rated': 'R', 'cast': ['Johnny Depp', 'John Densmore', 'Robby Krieger', 'Ray Manzarek'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg1NjQ3OTQwOF5BMl5BanBnXkFtZTcwMDE5NTgyMw@@._V1_SY1000_SX677_AL_.jpg', 'title': \"The Doors: When You're Strange\", 'fullplot': \"A chronological look at The Doors, focusing on lead singer, Jim Morrison (1943-1971), from the formation of the band in 1965, it's first gigs, and first album, to Morrison's death, after years of alcohol and drug use. Along the journey, we see archival footage of rehearsals, performances, and private moments including a Miami concert resulting in Morrison's arrest and trial for indecency. His love of the spotlight, his desire to be a poet, and his alcohol-fueled mood swings lead to a back and forth between public and private desires, successes, and failures. The band's music plays throughout.\", 'languages': ['English'], 'released': datetime.datetime(2010, 5, 12, 0, 0), 'directors': ['Tom DiCillo'], 'writers': ['Tom DiCillo'], 'awards': {'wins': 2, 'nominations': 1, 'text': '2 wins & 1 nomination.'}, 'lastupdated': '2015-09-11 11:23:16.900000000', 'year': 2009, 'imdb': {'rating': 7.7, 'votes': 6597, 'id': 1333667}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://whenyourestrangemovie.com/', 'viewer': {'rating': 3.9, 'numReviews': 5813, 'meter': 82}, 'dvd': datetime.datetime(2010, 6, 29, 0, 0), 'critic': {'rating': 5.8, 'numReviews': 68, 'meter': 62}, 'lastUpdated': datetime.datetime(2015, 9, 14, 18, 53, 3), 'consensus': \"It's far from a critical assessment of the band's music or its legacy, but When You're Strange gives fans a beautifully filmed, lovingly assembled tribute to the Doors.\", 'rotten': 26, 'production': 'Rhino Entertainment Co.', 'fresh': 42}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13cdf29313caabd83aca'), 'plot': \"A reimagined account of the early life of Maria Anna 'Nannerl' Mozart, five years older than Wolfgang, and a musical prodigy in her own right.\", 'genres': ['Biography', 'Drama', 'Music'], 'runtime': 120, 'metacritic': 71, 'cast': ['Marie Fèret', 'Marc Barbè', 'Delphine Chuillot', 'David Moreau'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTUxMDM4MDA0OV5BMl5BanBnXkFtZTcwMDUwNjkwNg@@._V1_SY1000_SX677_AL_.jpg', 'title': \"Mozart's Sister\", 'fullplot': 'Beginning in 1763, the film follows the Mozart family\\'s exhausting life on the road, traveling by coach from one royal court to the next, where the nobility marvel at young Wolfgang\\'s prodigious talent. But accomplished singer, harpsichordist, violinist Nannerl, Wolfgang\\'s elder by five years, first held forth as the family\\'s infant prodigy. At the film begins, she is still performing, though overshadowed and sidelined as accompanist by Wolfgang\\'s growing fame. Her father bows to social strictures \"for her own good,\" refusing to let her continue with the violin or compose, while privately conceding Nannerl\\'s talent to his wife. No longer a precocious tot, Nannerl chafes at the limitations imposed by her gender and frets about her prospects.', 'languages': ['French'], 'released': datetime.datetime(2010, 6, 9, 0, 0), 'directors': ['Renè Fèret'], 'writers': ['Renè Fèret (scenario)'], 'awards': {'wins': 2, 'nominations': 7, 'text': '2 wins & 7 nominations.'}, 'lastupdated': '2015-08-28 00:24:56.110000000', 'year': 2010, 'imdb': {'rating': 6.3, 'votes': 1150, 'id': 1653911}, 'countries': ['France'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cdf29313caabd83c93'), 'plot': 'A police officer is on a mission to apprehend a local M.L.A.', 'genres': ['Action', 'Crime', 'Drama'], 'runtime': 160, 'cast': ['Suriya', 'Anushka Shetty', 'Prakash Raj', 'Vivek'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BZDgyMjQ1MmEtZGY4YS00YWM1LWJmNTEtNzc2Y2Y2MTgzMjUzXkEyXkFqcGdeQXVyODk1OTg3MTI@._V1_SY1000_SX677_AL_.jpg', 'title': 'Singam', 'fullplot': \"Sub-Inspector Durai Singam lives a fairly wealthy lifestyle in Nallore along with his parents and a sister. He uses the powers vested in him wisely and well, and is, therefore, respected by everyone. He meets with and falls in love with Kavya Mahalingam but faces strong opposition from her Chennai-based businessman father, who does not approve of him. Before things could be sorted out, the High Court directs an influential gangster, Mayil Vaaganam, to report to Durai. The former initially refuses to attend, but relents and attempts to vainly use goon power to intimidate Durai and instead ends up humbled and humiliated. Upon the latter's return to Chennai, he ensures Durai gets transferred there and prepares a plan to terrorize and humiliate not only Durai but also his friends and family with impunity.\", 'languages': ['Tamil', 'Tulu', 'English'], 'released': datetime.datetime(2010, 5, 28, 0, 0), 'directors': ['Hari'], 'writers': ['Hari'], 'awards': {'wins': 2, 'nominations': 4, 'text': '2 wins & 4 nominations.'}, 'lastupdated': '2015-09-06 00:20:20.323000000', 'year': 2010, 'imdb': {'rating': 6.5, 'votes': 2755, 'id': 1655607}, 'countries': ['India'], 'type': 'movie'}\n",
