            "{'_id': ObjectId('573a13e7f29313caabdc7f3d'), 'plot': \"A man loves a woman, who's family does not believe in love.\", 'genres': ['Action', 'Romance'], 'runtime': 146, 'cast': ['Tiger Shroff', 'Kriti Sanon', 'Parth Akerkar', 'Anuradha Chandan'], 'poster': 'https://m.media-amazon.com/images/M/MV5BNGY4NDQxMDMtYmE0OS00ZDhiLTgyMTUtMGU4NzE3OGNmNGVmXkEyXkFqcGdeQXVyNjQ2MjQ5NzM@._V1_SY1000_SX677_AL_.jpg', 'title': 'Heropanti', 'fullplot': \"Rising from present India in the conflicting era of shining modernity and deep-rooted archaic traditions in the era of big city versus small towns, comes a love story sealed with an impossible fate. The story of the bold Bablu and the bratty Dimpy. Will Bablu and Dimpys love blossom under the terror of a brutal clan and the violent landscape it is set against. Heropanti is the story of today's youth, and the coming of age of its conflicting protagonists.\", 'languages': ['Hindi'], 'released': datetime.datetime(2014, 5, 23, 0, 0), 'directors': ['Sabir Khan'], 'writers': ['Sanjeev Dutta'], 'awards': {'wins': 2, 'nominations': 9, 'text': '2 wins & 9 nominations.'}, 'lastupdated': '2015-08-31 00:37:03.170000000', 'year': 2014, 'imdb': {'rating': 5.5, 'votes': 3561, 'id': 3142232}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 2.8, 'numReviews': 184, 'meter': 32}, 'production': 'UTV Communications', 'lastUpdated': datetime.datetime(2015, 9, 10, 17, 6, 24)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13e7f29313caabdc7f3c'), 'plot': \"The events of the Iranian Hostage Crisis and Canada's involvement, especially concerning Ambassador Ken Taylor, are explored.\", 'genres': ['Documentary', 'History'], 'runtime': 85, 'metacritic': 58, 'cast': ['Bob Anders', 'Joe Clark', 'William Daugherty', 'Carole Jerome'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY4MDUzOTkxNl5BMl5BanBnXkFtZTgwMDc3NjY5MDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Our Man in Tehran', 'fullplot': \"In 1979, the Iranian Revolution erupted. During this upheaval, the US Embassy and its personnel were seized by militants, while six diplomatic personnel managed to escape and find refuge courtesy of Canadian Ambassador Ken Taylor and his staff. Through their words and others' from that time, the events of that crisis are told as Canada found itself in the midst of an international intrigue that defied all conventional understanding. All this culminated in the Canadian government devising a way with CIA assistance to smuggle the fugitives out in an operation that would provide some hope during a dark time in American history.\", 'languages': ['English'], 'released': datetime.datetime(2015, 5, 15, 0, 0), 'directors': ['Drew Taylor', 'Larry Weinstein'], 'writers': ['Drew Taylor', 'Robert Wright'], 'awards': {'wins': 8, 'nominations': 0, 'text': '8 wins.'}, 'lastupdated': '2015-08-20 00:57:56.627000000', 'year': 2013, 'imdb': {'rating': 7.6, 'votes': 112, 'id': 3142234}, 'countries': ['Canada'], 'type': 'movie', 'tomatoes': {'website': 'http://firstrunfeatures.com/ourmanintehran_press.html', 'viewer': {'rating': 4.2, 'numReviews': 154, 'meter': 90}, 'dvd': datetime.datetime(2015, 8, 31, 0, 0), 'critic': {'rating': 7.2, 'numReviews': 17, 'meter': 82}, 'boxOffice': '$2.3k', 'rotten': 3, 'production': 'First Run Features', 'lastUpdated': datetime.datetime(2015, 9, 1, 18, 11, 11), 'fresh': 14}, 'num_mflix_comments': 0}\n",
