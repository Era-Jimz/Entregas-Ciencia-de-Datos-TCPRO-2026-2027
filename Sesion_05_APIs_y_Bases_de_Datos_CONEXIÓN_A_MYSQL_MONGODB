            "{'_id': ObjectId('573a13e9f29313caabdcbc92'), 'plot': 'Two eccentric scientists struggle to create eternal youth in a world they call \"blind to the tragedy of old age.\" As they battle their own aging and suffer the losses of loved ones, their scientific journeys ultimately become personal.', 'genres': ['Documentary', 'Drama'], 'runtime': 78, 'metacritic': 53, 'cast': ['Bill Andrews', 'Colin Blakemore', 'Adelaide Carpenter', 'Aubrey de Grey'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg0MjI5NzE3M15BMl5BanBnXkFtZTgwNTM4NjU0MzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Immortalists', 'fullplot': 'This is the story of two biologists who believe human immortality is upon us. With humor and wonder, this film peels back the layers of their science and their personal lives. Who are they, and is this even possible? Is it dangerous? Their motto: Live forever, or die trying.', 'languages': ['English'], 'released': datetime.datetime(2014, 3, 8, 0, 0), 'directors': ['David Alvarado', 'Jason Sussberg'], 'writers': ['Jason Sussberg'], 'awards': {'wins': 1, 'nominations': 2, 'text': '1 win & 2 nominations.'}, 'lastupdated': '2015-08-21 00:02:29.970000000', 'year': 2014, 'imdb': {'rating': 6.4, 'votes': 145, 'id': 3267194}, 'countries': ['UK', 'USA', 'India'], 'type': 'movie'}\n",
