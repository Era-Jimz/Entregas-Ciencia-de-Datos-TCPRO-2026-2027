            "{'_id': ObjectId('573a13d9f29313caabda97d8'), 'plot': 'A Taiwanese high school baseball team travels to Japan in 1931 to compete in a national tournament.', 'genres': ['Biography', 'Drama', 'History'], 'runtime': 185, 'cast': ['Togo Igawa', 'Takao Ohsawa', 'Masatoshi Nagase', 'Chiao Chiao'], 'num_mflix_comments': 0, 'title': 'Kano', 'fullplot': 'Under Japanese rule, an underdog high school baseball team from southern Taiwan defeats the heretofore superior northern teams and wins a rare opportunity to represent the colony in the 1931 empire-wide tournament. Comprised of Taiwanese, Taiwanese aboriginals and Japanese players, \"Kanè,\" the Kagi Nourin School team, must integrate the ethnically mixed roster and make the best of its unique strengths to not just survive but thrive in the elite league.', 'languages': ['Japanese', 'Min Nan'], 'released': datetime.datetime(2014, 2, 27, 0, 0), 'directors': ['Chih-Hsiang Ma'], 'writers': ['Ruby Chen', 'Te-Sheng Wei'], 'awards': {'wins': 5, 'nominations': 7, 'text': '5 wins & 7 nominations.'}, 'lastupdated': '2015-08-30 00:48:35.400000000', 'year': 2014, 'imdb': {'rating': 8.0, 'votes': 1371, 'id': 2247566}, 'countries': ['Taiwan'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.1, 'numReviews': 104}, 'lastUpdated': datetime.datetime(2015, 7, 27, 19, 8, 28)}}\n",
            "{'_id': ObjectId('573a13d9f29313caabda9ca6'), 'plot': 'Consuming Spirits 16mm to HD, is an Independent feature animation, chronicling the lives of three characters who live in a rust belt town called Magguson, and work at its local newspaper ...', 'genres': ['Animation', 'Comedy', 'Drama'], 'runtime': 136, 'metacritic': 81, 'cast': ['Nancy Andrews', 'Chris Sullivan', 'Judith Rafael', 'Mary Lou Zelazny'], 'title': 'Consuming Spirits', 'fullplot': 'Consuming Spirits 16mm to HD, is an Independent feature animation, chronicling the lives of three characters who live in a rust belt town called Magguson, and work at its local newspaper The Daily Suggester. They are: Gentian Violet 42: Victor Blue 38: and Earl gray 64: first appear to be acquaintances. But as the film unfolds, we find they have a long diabolical history, revolving around social service intervention, and foster care, romance and hatred. Each character has family secrets to hide, and family secrets to discover. An auto accident one dark and inebriated night, causes a crack in the memory vault of these intimate strangers. By films end all parties walk from the woods, both healed and wounded..enjoy..', 'languages': ['English'], 'released': datetime.datetime(2012, 12, 12, 0, 0), 'directors': ['Chris Sullivan'], 'writers': ['Chris Sullivan'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-29 00:08:52.110000000', 'year': 2012, 'imdb': {'rating': 7.8, 'votes': 90, 'id': 2253947}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.8, 'numReviews': 221, 'meter': 72}, 'fresh': 17, 'critic': {'rating': 8.3, 'numReviews': 19, 'meter': 89}, 'rotten': 2, 'lastUpdated': datetime.datetime(2015, 6, 16, 18, 15, 55)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13d9f29313caabda9c79'), 'plot': 'After he performs a dangerous dare-devil stunt at an air show, South Korean Air Force pilot Tae-hun is kicked out of the elite Black Eagles flying team and transferred to a combat unit ...', 'genres': ['Action', 'Drama', 'Romance'], 'runtime': 113, 'cast': ['Rain', 'Joon-sang Yoo', 'Seong-su Kim', 'Ha-na Lee'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjE1NzIzMDI5Nl5BMl5BanBnXkFtZTgwMzUzMTAzMjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Soar Into the Sun', 'fullplot': 'After he performs a dangerous dare-devil stunt at an air show, South Korean Air Force pilot Tae-hun is kicked out of the elite Black Eagles flying team and transferred to a combat unit where he immediately comes into conflict with ace pilot Cheol-hui. He makes friends with the other pilots in the unit and falls in love with the beautiful Se-young, who is in charge of maintenance. When a North Korean MIG fighter threatens, the group engages in a gripping dogfight that leaves one comrade dead and another missing. Cheol-hui and Tae-hun join forces to rescue their missing friend and prevent a catastrophic war.', 'languages': ['Korean'], 'released': datetime.datetime(2012, 8, 24, 0, 0), 'directors': ['Dong-won Kim'], 'writers': ['Sang-hoon Ahn (screenplay)', 'Dong-won Kim (screenplay)'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-02 00:41:02.663000000', 'year': 2012, 'imdb': {'rating': 6.1, 'votes': 1127, 'id': 2253742}, 'countries': ['South Korea'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.4, 'numReviews': 236, 'meter': 62}, 'dvd': datetime.datetime(2013, 3, 11, 0, 0), 'production': 'CJ Entertainment', 'lastUpdated': datetime.datetime(2015, 7, 21, 19, 25, 31)}}\n",
