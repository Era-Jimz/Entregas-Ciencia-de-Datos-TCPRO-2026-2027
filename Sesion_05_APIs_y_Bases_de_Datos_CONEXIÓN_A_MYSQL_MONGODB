            "{'_id': ObjectId('573a13cbf29313caabd802bb'), 'plot': 'A group of teenagers get ready for their high school prom.', 'genres': ['Comedy', 'Drama'], 'runtime': 104, 'metacritic': 50, 'rated': 'PG', 'cast': ['Aimee Teegarden', 'Thomas McDonell', 'DeVaughn Nixon', 'Danielle Campbell'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQyNDcyODI2NV5BMl5BanBnXkFtZTcwMTA3NTAzNA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Prom', 'fullplot': \"Prom and high school graduation are approaching for a group of seniors, but when the prom decorations are destroyed in an act of school vandalism, the class president is left scrambling. With everybody else pre-occupied with finding dates and dresses, Nova is left to rely on the principal forcing the school rebel to help her out. But when he's there for her when she needs it, she starts looking at him in a different light.\", 'languages': ['English'], 'released': datetime.datetime(2011, 4, 29, 0, 0), 'directors': ['Joe Nussbaum'], 'writers': ['Katie Wech'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-11 00:08:51.233000000', 'year': 2011, 'imdb': {'rating': 5.4, 'votes': 11821, 'id': 1604171}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
