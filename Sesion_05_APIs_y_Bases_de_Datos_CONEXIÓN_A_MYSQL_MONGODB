            "{'_id': ObjectId('573a13d8f29313caabda589e'), 'plot': 'A documentary on the annual three-day \"pop-up\" medical clinic organized by the non-profit Remote Area Medical (RAM) in Bristol, Tennessee\\'s NASCAR speedway.', 'genres': ['Documentary'], 'runtime': 81, 'metacritic': 71, 'title': 'Remote Area Medical', 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg5MDk3Nzk0Nl5BMl5BanBnXkFtZTgwNzUwMjIzMDE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['USA'], 'fullplot': 'A debate over healthcare has been raging nationwide, but what\\'s been lost in the discussion are the American citizens who live day after day, year after year without solutions for their most basic needs. Remote Area Medical documents the annual three-day \"pop-up\" medical clinic organized by the non-profit Remote Area Medical (RAM) in Bristol, Tennessee\\'s NASCAR speedway. Instead of a film about policy, Remote Area Medical is a film about people, about a proud Appalachian community banding together to try and provide some relief for friends and neighbors who are simply out of options.', 'languages': ['English'], 'released': datetime.datetime(2013, 4, 6, 0, 0), 'directors': ['Jeff Reichert', 'Farihah Zaman'], 'awards': {'wins': 3, 'nominations': 0, 'text': '3 wins.'}, 'lastupdated': '2015-08-07 00:07:49.583000000', 'year': 2013, 'imdb': {'rating': 5.8, 'votes': 94, 'id': 2180503}, 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.8, 'numReviews': 42, 'meter': 73}, 'critic': {'rating': 7.1, 'numReviews': 17, 'meter': 88}, 'lastUpdated': datetime.datetime(2015, 8, 20, 18, 26, 2), 'rotten': 2, 'production': 'Cinedigm Entertainment', 'fresh': 15}}\n",
            "{'_id': ObjectId('573a13d8f29313caabda58b5'), 'plot': 'At the end of his life, Wilhelm Reich - psychiatrist and experimental scientist searching for the fundamentals of life - finds himself on trial, charged with deception. His dream of ...', 'genres': ['Biography', 'Drama'], 'countries': ['Austria'], 'cast': ['Klaus Maria Brandauer', 'Julia Jentsch', 'Jeanette Hain', 'Jamie Sives'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjEwNjQyNTcyOF5BMl5BanBnXkFtZTgwMDAzNzQ1MTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Strange Case of Wilhelm Reich', 'fullplot': \"At the end of his life, Wilhelm Reich - psychiatrist and experimental scientist searching for the fundamentals of life - finds himself on trial, charged with deception. His dream of liberating human individuality makes him a dangerous opponent of an American system that is striving after 1945 for global hegemony, using all available means. Was it madness to believe in man's liberty or was Reich simply in the wrong place at the wrong time, and, being a holistic global thinker, accurately observing far-reaching socio-political linkages? Ten years after his mysterious death, his writings, once burnt by the US FDA, become an important source of inspiration for a '68 generation in revolt.\", 'languages': ['German', 'English'], 'released': datetime.datetime(2013, 9, 5, 0, 0), 'directors': ['Antonin Svoboda'], 'writers': ['Rebecca Blasband', 'Antonin Svoboda'], 'awards': {'wins': 0, 'nominations': 5, 'text': '5 nominations.'}, 'lastupdated': '2015-08-20 00:54:49.063000000', 'year': 2012, 'imdb': {'rating': 5.8, 'votes': 111, 'id': 2180549}, 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.5, 'numReviews': 15}, 'production': 'Movienet', 'lastUpdated': datetime.datetime(2015, 8, 7, 20, 9, 21)}}\n",
