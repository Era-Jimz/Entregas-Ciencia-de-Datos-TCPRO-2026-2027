            "{'_id': ObjectId('573a13dff29313caabdb8d69'), 'plot': 'Maèna is the daughter of the Innu leader Mishtenapuu, who attends a bloody confrontation between his clan and the clan of \"Men of the Land Without Trees.\" Following this confrontation, ...', 'genres': ['Adventure'], 'runtime': 102, 'cast': ['Reneltta Arluk', 'Mary Buscemi', 'Tantoo Cardinal', 'Flint Eagle'], 'num_mflix_comments': 0, 'title': 'Maèna', 'fullplot': 'Maèna is the daughter of the Innu leader Mishtenapuu, who attends a bloody confrontation between his clan and the clan of \"Men of the Land Without Trees.\" Following this confrontation, Maèna chooses a mission that will change her life. To fulfill the promise that she has made to her friend Matsii on her deathbed, she embarked on the trail of their enemies to deliver Nipki, a 11 year old boy that the Inuit have captured. But she was also taken as prisoner by Natak, the leader of the Inuit group, and forcibly taken to the Land Without Trees.', 'languages': ['Inuktitut', 'English'], 'released': datetime.datetime(2013, 10, 1, 0, 0), 'directors': ['Michel Poulette'], 'writers': ['Pierre Billon', 'Dominique Demers (novel)'], 'awards': {'wins': 1, 'nominations': 8, 'text': '1 win & 8 nominations.'}, 'lastupdated': '2015-08-20 00:37:25.033000000', 'year': 2013, 'imdb': {'rating': 6.5, 'votes': 153, 'id': 2600730}, 'countries': ['Canada'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.2, 'numReviews': 51}, 'lastUpdated': datetime.datetime(2015, 7, 29, 19, 11, 51)}}\n",
            "{'_id': ObjectId('573a13dff29313caabdb909e'), 'plot': 'Danny, a commercial editor and documentary filmmaker attempts to finish his film, a study on relationship while navigating the relationships in his own life. Will he continue to chase the ...', 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 94, 'cast': ['Jessie Barr', 'Louis Cancelmi', 'Margaret Daly', 'Caitlin FitzGerald'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjMzODk2MDc0MF5BMl5BanBnXkFtZTgwMTc3NjU4NjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Manhattan Romance', 'fullplot': \"Danny, a commercial editor and documentary filmmaker attempts to finish his film, a study on relationship while navigating the relationships in his own life. Will he continue to chase the unattainable Theresa a hippy new age dancer(Caitlin Fitzgerald) or will he finally admit he's in love with his best friend Carla (Katherine Waterston) who is in an unfulfilling relationship with a political strategist(Gaby Hoffman). Manhattan Romance is a funny insightful look at contemporary life in Manhattan. It explores new age ideas and open relationship as well as true friendship and connection.\", 'languages': ['English'], 'released': datetime.datetime(2015, 10, 2, 0, 0), 'directors': [\"Tom O'Brien\"], 'writers': [\"Tom O'Brien\"], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-08-28 00:17:01.610000000', 'year': 2015, 'imdb': {'rating': '', 'votes': '', 'id': 2608324}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 0.0, 'numReviews': 2}, 'lastUpdated': datetime.datetime(2015, 9, 2, 18, 57, 41)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13dff29313caabdb9473'), 'plot': \"Acclaimed filmmaker Alan Berliner chronicles the deeply personal story of his mother's first cousin--well-known poet/translator/professor Edwin Honig--on his journey into the depths of ...\", 'genres': ['Documentary'], 'runtime': 78, 'metacritic': 94, 'cast': ['Eli Berliner', 'Stuart Blazer', 'Susan Brown', 'Barbara Estrin'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTc4MDU1OTA2OV5BMl5BanBnXkFtZTgwMTA1MDQ4MDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'First Cousin Once Removed', 'fullplot': \"Acclaimed filmmaker Alan Berliner chronicles the deeply personal story of his mother's first cousin--well-known poet/translator/professor Edwin Honig--on his journey into the depths of Alzheimer's disease. Shot over the course of five years, the film presents an unflinching portrait of Edwin's work and life while documenting his slow mental deterioration through visits and interviews with Edwin and his friends, former students, and others, along with archival footage and more.\", 'languages': ['English'], 'released': datetime.datetime(2014, 2, 13, 0, 0), 'directors': ['Alan Berliner'], 'awards': {'wins': 2, 'nominations': 4, 'text': '2 wins & 4 nominations.'}, 'lastupdated': '2015-07-02 00:31:23.317000000', 'year': 2012, 'imdb': {'rating': 7.4, 'votes': 215, 'id': 2615134}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 0.0, 'numReviews': 0}, 'lastUpdated': datetime.datetime(2015, 5, 23, 18, 31, 42)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13dff29313caabdb8a66'), 'plot': 'A group of twenty-somethings struggle to cope with break ups, student debt, and the transition to adulthood while living with their parents in the suburbs of New York City.', 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 95, 'cast': ['Ryan Metcalf', 'Arjun Gupta', 'Mary Kate Wiles', 'Annet Mahendru'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BODk1MjEyNTY2MV5BMl5BanBnXkFtZTgwMTE2MjU0NzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Bridge and Tunnel', 'fullplot': \"Long Islanders Sal, Terry, Nate, Eric and Lina are childhood friends who grew up in post 9/11 suburban New York, graduated high school at the peak of the War on Terror, and began adulthood amidst a global financial crisis. Now at the crossroads of their mid-twenties they find themselves unhappy with their places in life. As a year unfolds, the group of friends are tested with spells of unemployment, disintegrating relationships, and the destruction of Hurricane Sandy as they attempt to move forward with their lives despite society and Mother Nature's best efforts to keep them stagnant.\", 'languages': ['English'], 'released': datetime.datetime(2014, 9, 26, 0, 0), 'directors': ['Jason Michael Brescia'], 'writers': ['Jason Michael Brescia'], 'awards': {'wins': 12, 'nominations': 30, 'text': '12 wins & 30 nominations.'}, 'lastupdated': '2015-08-25 01:08:52.523000000', 'year': 2014, 'imdb': {'rating': 7.1, 'votes': 44, 'id': 2593410}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.0, 'numReviews': 46, 'meter': 100}, 'website': 'http://www.bridgetunnelfilm.com', 'production': 'Glacier Road Productions', 'lastUpdated': datetime.datetime(2015, 8, 23, 18, 44, 47)}}\n",
