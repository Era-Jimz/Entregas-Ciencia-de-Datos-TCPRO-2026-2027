            "{'_id': ObjectId('573a13ecf29313caabdd2671'), 'plot': \"A group of lifelong mob movie extras mount a production of Shakespeare's Julius Caesar in their local Staten Island theater in order to finally get some speaking roles. But the theater is ...\", 'genres': ['Comedy'], 'runtime': 88, 'cast': ['Michael Rispoli', 'Annabella Sciorra', 'Paul Ben-Victor', 'Katie Stevens'], 'title': 'Friends and Romans', 'fullplot': \"A group of lifelong mob movie extras mount a production of Shakespeare's Julius Caesar in their local Staten Island theater in order to finally get some speaking roles. But the theater is the secret hideout of a real-life gangster who fancies himself an actor, and whom the FBI are hunting for the recent murder of a Broadway producer. The Feds insert their own undercover agent to audition for the role of Cassius, seeking to determine who is the real gangster among a cast of make-believe criminals. All the while, the oblivious cast seek only to prove to themselves, their families, and friends that they are more than just extras.\", 'languages': ['English'], 'released': datetime.datetime(2014, 10, 17, 0, 0), 'directors': ['Christopher Kublan'], 'writers': ['Gregg Greenberg', 'Christopher Kublan', 'Michael Rispoli'], 'awards': {'wins': 2, 'nominations': 0, 'text': '2 wins.'}, 'lastupdated': '2015-08-04 00:51:07.680000000', 'year': 2014, 'imdb': {'rating': 7.2, 'votes': 9, 'id': 3480942}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13ecf29313caabdd21a3'), 'plot': 'In 1985, Kung Fury, the toughest martial artist cop in Miami, goes back in time to kill the worst criminal of all time - kung fuhrer Hitler.', 'genres': ['Short', 'Action', 'Comedy'], 'runtime': 31, 'cast': ['David Sandberg', 'Jorma Taccone', 'Steven Chew', 'Leopold Nilsson'], 'num_mflix_comments': 2, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjQwMjU2ODU5NF5BMl5BanBnXkFtZTgwNTU1NjM4NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Kung Fury', 'fullplot': 'During an unfortunate series of events a friend of Kung Fury is assassinated by the most dangerous kung fu master criminal of all time; Adolf Hitler, a.k.a Kung Fèhrer. Kung Fury decides to travel back in time, to Nazi Germany, in order to kill Hitler and end the Nazi empire once and for all.', 'languages': ['English', 'Swedish', 'German'], 'released': datetime.datetime(2015, 5, 28, 0, 0), 'directors': ['David Sandberg'], 'writers': ['David Sandberg'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-10 17:20:55.477000000', 'year': 2015, 'imdb': {'rating': 8.3, 'votes': 24575, 'id': 3472226}, 'countries': ['Sweden'], 'type': 'movie'}\n",
