            "{'_id': ObjectId('573a13ddf29313caabdb4b0a'), 'plot': \"A portrait of recently retired Congressman Barney Frank, one of America's most well-known and least understood political figures.\", 'genres': ['Documentary', 'Biography', 'Drama'], 'runtime': 87, 'cast': ['Spencer Bachus', 'Mike Barnicle', 'Neil Barofsky', 'Dustin Lance Black'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BOTk2OTE4NzQ3NF5BMl5BanBnXkFtZTgwNTcxODQwNDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Compared to What: The Improbable Journey of Barney Frank', 'fullplot': \"An intimate portrait of recently retired Congressman Barney Frank, one of our most well-known and least understood political figures, this documentary alternates between deeply personal moments and the inner workings of our political process. Rare archival material and interviews reveal the emotional pain and harmful effects of a closeted life, the relief of coming out and the triumph of love through the Congressman's historic same-sex marriage. Frank's journey is our country's journey, a classic American story about a dedicated public servant who never loses hope.\", 'languages': ['English'], 'released': datetime.datetime(2015, 10, 15, 0, 0), 'directors': ['Sheila Canavan', 'Michael Chandler'], 'awards': {'wins': 2, 'nominations': 0, 'text': '2 wins.'}, 'lastupdated': '2015-08-24 00:35:28.773000000', 'year': 2014, 'imdb': {'rating': 4.7, 'votes': 74, 'id': 2452352}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.8, 'numReviews': 5}, 'lastUpdated': datetime.datetime(2015, 5, 23, 18, 33, 46)}}\n",
            "{'_id': ObjectId('573a13ddf29313caabdb49d3'), 'plot': \"Jon Mikl Thor was a bodybuilding, steel bending, brick smashing rock star in the 70's and 80's whose theatrical band, Thor, never quite made it big. Years later he attempts a comeback that nearly kills him.\", 'genres': ['Documentary', 'Biography', 'Music'], 'runtime': 84, 'cast': ['Jon Mikl Thor', 'Mike Favata', 'Steve Price', 'Linda Dawe'], 'title': 'I Am Thor', 'fullplot': \"Jon Mikl Thor was a bodybuilding, steel bending, brick smashing rock star in the 70's and 80's whose theatrical band THOR hit the scene alongside Metallica and Kiss, but never achieved the gold record status of its contemporaries. After a brief but memorable film career saw him starring in the cult classics Rock 'n' Roll Nightmare and Zombie Nightmare, Thor all but disappeared from the entertainment map. But ten years into retirement, and incapable of living like a normal mortal human being, Thor attempts a comeback to achieve the level of success that had eluded him his entire career - a comeback that nearly kills him. Tracing the rise, fall, and rebirth of a determined performer over the course of a career that has seen more than its fair share of highs and lows, I AM THOR paints a fascinating and sometimes unbelievable portrait of this larger-than-life icon.\", 'languages': ['English'], 'released': datetime.datetime(2015, 11, 1, 0, 0), 'directors': ['Ryan Wise'], 'awards': {'wins': 0, 'nominations': 4, 'text': '4 nominations.'}, 'lastupdated': '2015-08-05 00:56:15.913000000', 'year': 2015, 'imdb': {'rating': 8.1, 'votes': 29, 'id': 2450258}, 'countries': ['USA', 'Canada', 'Finland', 'Sweden'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.5, 'numReviews': 8}, 'lastUpdated': datetime.datetime(2015, 7, 12, 19, 16, 1)}, 'num_mflix_comments': 0}\n",
