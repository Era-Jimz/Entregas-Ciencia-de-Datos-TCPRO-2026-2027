            "{'_id': ObjectId('573a13caf29313caabd7e5fc'), 'plot': 'A city girl who moves to a small town and becomes entangled in a love triangle between her high school teacher and a stoner classmate.', 'genres': ['Drama', 'Romance'], 'runtime': 98, 'metacritic': 57, 'rated': 'R', 'cast': ['Kat Dennings', 'Reece Thompson', 'Andie MacDowell', 'Josh Lucas'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTgxNjk2MTIyNl5BMl5BanBnXkFtZTcwNDc5MDA4NA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Daydream Nation', 'fullplot': \"Big city girl Caroline is new to a small town, she disregards her high school classmates, and then just for kicks starts a sexual relationship with her teacher, Mr. A. Meanwhile, there's a serial killer roaming the town, an industrial fire burning on the outskirts, and Thurston is mourning the loss of his best friend. As Thurston falls in love with Caroline, realities quickly catch up to all characters, and they are all going to have mature or face the consequences.\", 'languages': ['English'], 'released': datetime.datetime(2011, 5, 6, 0, 0), 'directors': ['Michael Goldbach'], 'writers': ['Michael Goldbach (screenplay)'], 'awards': {'wins': 1, 'nominations': 6, 'text': '1 win & 6 nominations.'}, 'lastupdated': '2015-09-06 00:58:03.040000000', 'year': 2010, 'imdb': {'rating': 6.4, 'votes': 9773, 'id': 1581835}, 'countries': ['Canada'], 'type': 'movie'}\n",
