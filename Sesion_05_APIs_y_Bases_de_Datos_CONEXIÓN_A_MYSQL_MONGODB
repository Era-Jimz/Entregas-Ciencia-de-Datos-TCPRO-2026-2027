            "{'_id': ObjectId('573a13cbf29313caabd7f41e'), 'plot': 'A teenage hockey player becomes a national sensation.', 'genres': ['Musical'], 'runtime': 93, 'cast': ['John McDermott', 'Noah Reid', 'Hawksley Workman', 'Dave Bidini'], 'poster': 'https://m.media-amazon.com/images/M/MV5BOTY5NjE2ZTgtN2NkZS00NzAzLWE1NDMtOTY3NTkzNjJmOWI1XkEyXkFqcGdeQXVyNTM0NTU5Mg@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Score: A Hockey Musical', 'fullplot': \"Seventeen-year-old Farley has led a sheltered life, raised on a diet of home schooling, organic living and trips to the art gallery. To his parents' dismay, Farley loves to play shinny with the local rink rats. To their even greater dismay, Farley is scouted and signed by the owner (Stephen McHattie) of a junior league team, where he becomes an instant star. But Farley discovers that stardom comes with a price-including the expectation to fight on the ice. Throw in a changing relationship with his best friend (Allie MacDonald), and Farley finds himself losing his way.\", 'languages': ['English', 'Russian', 'Italian'], 'released': datetime.datetime(2010, 10, 22, 0, 0), 'directors': ['Michael McGowan'], 'writers': ['Michael McGowan'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-08-16 00:30:26.277000000', 'year': 2010, 'imdb': {'rating': 4.8, 'votes': 415, 'id': 1592876}, 'countries': ['Canada'], 'type': 'movie', 'num_mflix_comments': 0}\n",
