            "{'_id': ObjectId('573a13ccf29313caabd83422'), 'plot': 'Five high school kids, Olivia, Wendall, Stella, Charlie, and \"Mo\", meet in detention and start a band based off the lemonade vending machine outside the detention room.', 'genres': ['Family', 'Musical'], 'runtime': 103, 'cast': ['Bridgit Mendler', 'Adam Hicks', 'Hayley Kiyoko', 'Naomi Scott'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMDQ4YjVhNDQtNjZiNS00NDgyLWE3ODYtOWFkNWVkZDk0MDY1XkEyXkFqcGdeQXVyNTk5NDY5Njc@._V1_SY1000_SX677_AL_.jpg', 'title': 'Lemonade Mouth', 'fullplot': '\"Lemonade Mouth\" tells kids and tweens that building your confidence rocks and finding your destiny rules. The story follows five disparate high school students - Olivia (Bridgit Mendler), Mo (Naomi Scott), Charlie (Blake Michael), Stella (Hayley Kiyoko), and Wen (Adam Hicks) who meet in detention. They realize they are destined to rock, and ultimately form a band that becomes a champion for students sidelined by the high school elite.', 'languages': ['English'], 'released': datetime.datetime(2011, 4, 15, 0, 0), 'directors': ['Patricia Riggen'], 'writers': ['April Blair (teleplay)', 'Mark Peter Hughes (novel)'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-09-13 00:05:06.430000000', 'year': 2011, 'imdb': {'rating': 7.0, 'votes': 7549, 'id': 1648204}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
