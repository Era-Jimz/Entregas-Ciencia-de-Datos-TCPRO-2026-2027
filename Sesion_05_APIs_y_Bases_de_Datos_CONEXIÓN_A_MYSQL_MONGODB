            "{'_id': ObjectId('573a13ccf29313caabd82dd5'), 'plot': 'An agoraphobic father teams up with a renegade priest to save his daughter from the clutches of a gang of twisted feral children who committed an act of violence against his family years earlier.', 'genres': ['Drama', 'Horror', 'Thriller'], 'runtime': 84, 'metacritic': 60, 'rated': 'R', 'cast': ['Aneurin Barnard', 'James Cosmo', 'Wunmi Mosaku', 'Ian Hanmore'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMzIwMTQ2NTAyM15BMl5BanBnXkFtZTcwNDIzMjQ0OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Citadel', 'fullplot': 'Tommy Cowley is a young father inflicted with chronic agoraphobia since his wife was brutally attacked by a gang of a twisted feral children. Trapped in the dilapidated suburbia of Edenstown, he finds himself terrorised by the same gang, who now seem intent on taking his baby daughter. Torn between the help of an understanding nurse and a vigilante priest, Tommy sets out to learn the nightmarish truth surrounding these hooded children. He also discovers that to be free of his fears, he must finally face the demons of his past and enter the one place that he fears the most - the abandoned tower block known as the Citadel.', 'languages': ['English'], 'released': datetime.datetime(2013, 3, 1, 0, 0), 'directors': ['Ciarèn Foy'], 'writers': ['Ciarèn Foy'], 'awards': {'wins': 12, 'nominations': 6, 'text': '12 wins & 6 nominations.'}, 'lastupdated': '2015-08-19 00:18:57.047000000', 'year': 2012, 'imdb': {'rating': 5.4, 'votes': 5131, 'id': 1641975}, 'countries': ['Ireland', 'UK'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13ccf29313caabd82d23'), 'plot': \"Toward the end of World War II, middle-aged soldier Keita is entrusted with a postcard from a comrade who is sure he will die in battle. After the war ends, Keita visits his comrade's wife ...\", 'genres': ['Drama', 'Romance', 'War'], 'runtime': 114, 'cast': ['Etsushi Toyokawa', 'Shinobu ètake', 'Naomasa Musaka', 'Akira Emoto'], 'num_mflix_comments': 0, 'title': 'Postcard', 'fullplot': \"Toward the end of World War II, middle-aged soldier Keita is entrusted with a postcard from a comrade who is sure he will die in battle. After the war ends, Keita visits his comrade's wife Yuko and bears witness to the tragic life she has led. This year's Oscar entry from Japan finds SHINDO in top form and his 49th and reportedly last film as fresh and poignant as ever.\", 'languages': ['Japanese'], 'released': datetime.datetime(2011, 8, 6, 0, 0), 'directors': ['Kaneto Shindè'], 'writers': ['Kaneto Shindè (screenplay)'], 'awards': {'wins': 7, 'nominations': 5, 'text': '7 wins & 5 nominations.'}, 'lastupdated': '2015-07-24 00:25:50.023000000', 'year': 2010, 'imdb': {'rating': 7.1, 'votes': 157, 'id': 1641397}, 'countries': ['Japan'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13ccf29313caabd82a23'), 'plot': 'An in-depth look at the rise and fall of New York Governor Eliot Spitzer, including interviews with the scandalized, former politician.', 'genres': ['Documentary'], 'runtime': 117, 'metacritic': 68, 'rated': 'R', 'cast': ['Eliot Spitzer', 'Michael Schwendeman', 'Kim Allen', 'Lloyd Constantine'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMzY2MzY0NDg1OF5BMl5BanBnXkFtZTcwMjkzNjg4Mw@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Client 9: The Rise and Fall of Eliot Spitzer', 'fullplot': \"Documentary on the rise of Eliot Spitzer, first as Attorney General and then Governor of New York and his subsequent downfall due to a sex scandal. Spitzer had a hard driving, take no prisoners approach to prosecuting criminals. When he focused his efforts on Wall Street, he came up against some very powerful men. The chink in his armor was an escort whom he met regularly. When the fact that he spent time with a prostitute became public the knives came out so to speak, and Spitzer found himself isolated, resigning the Governorship. At one point, Spitzer recounts the story of a friend who gave him a t-shirt with 'Hubris is Terminal' printed on the front. A fitting epitaph somehow for his political career.\", 'languages': ['English'], 'released': datetime.datetime(2011, 3, 4, 0, 0), 'directors': ['Alex Gibney'], 'writers': ['Alex Gibney'], 'awards': {'wins': 0, 'nominations': 8, 'text': '8 nominations.'}, 'lastupdated': '2015-08-28 00:07:46.720000000', 'year': 2010, 'imdb': {'rating': 7.4, 'votes': 1646, 'id': 1638362}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13ccf29313caabd82ac4'), 'plot': 'Recently released from prison, an ex-mafia boss tries not to fall into his old habits, but surviving outside of the mafia is harder than it seems.', 'genres': ['Comedy', 'Drama'], 'runtime': 98, 'rated': 'R', 'cast': ['Paul Sorvino', 'Michael Rapaport', 'Renee Props', 'Andrea Kelly'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTYyMzg3MDg1MF5BMl5BanBnXkFtZTgwNTI3NjczMzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Once Upon a Time in Queens', 'fullplot': \"After spending 20 years in federal prison for myriad crimes, the ailing Mafia Capo Joseph 'Mr. Joe' Scoleri was released. As he tries to reconnect with his daughter and establish a relationship with his neighbor, he realizes that the life he knew no longer exists and nothing is the same as it was before he went away.\", 'languages': ['English'], 'released': datetime.datetime(2013, 6, 8, 0, 0), 'directors': ['Dave Rodriguez'], 'writers': ['Dave Rodriguez'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-02 00:05:54.693000000', 'year': 2013, 'imdb': {'rating': 6.0, 'votes': 265, 'id': 1639397}, 'countries': ['USA'], 'type': 'movie'}\n",
