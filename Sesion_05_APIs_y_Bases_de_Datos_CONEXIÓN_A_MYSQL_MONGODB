            "{'_id': ObjectId('573a13cdf29313caabd844ae'), 'plot': 'An ex-con on the run from his criminal past, hides out from those he ratted on by chaperoning a field trip to New Orleans.', 'genres': ['Action', 'Comedy', 'Family'], 'runtime': 103, 'metacritic': 33, 'rated': 'PG-13', 'cast': ['Paul Levesque', 'Kevin Corrigan', 'Josè Zèèiga', 'Kevin Rankin'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTkyOTE2NTM4NF5BMl5BanBnXkFtZTcwMDU3NjYzNA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Chaperone', 'fullplot': \"Ray Bradstone (Levesque) is the best wheel man in the business, but he is determined to go straight and be the best parent he can be to his daughter, Sally (Winter), and make amends with his ex-wife, Lynne (Gish). As Ray struggles to find honest work, his old bank-robbing crew, led by Phillip Larue (Corrigan), offers him one last job. He agrees at first, but changes his mind at the last second leaving the crew without a driver. Ray decides instead to serve as a chaperone for Sally's school field trip. When the robbery goes awry, Larue blames Ray and chases the school bus all the way to the Museum of Natural History in New Orleans. Ray must deal with Larue, while supervising Sally's class on what becomes one of the craziest school trips ever.\", 'languages': ['English'], 'released': datetime.datetime(2011, 3, 24, 0, 0), 'directors': ['Stephen Herek'], 'writers': ['S.J. Roth'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-21 00:33:39.033000000', 'year': 2011, 'imdb': {'rating': 5.1, 'votes': 3984, 'id': 1663187}, 'countries': ['USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cdf29313caabd84040'), 'plot': 'An introvert freshman is taken under the wings of two seniors who welcome him to the real world.', 'genres': ['Drama', 'Romance'], 'runtime': 102, 'metacritic': 67, 'rated': 'PG-13', 'cast': ['Logan Lerman', 'Dylan McDermott', 'Kate Walsh', 'Patrick de Ledebur'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMzIxOTQyODU1OV5BMl5BanBnXkFtZTcwMDQ4Mjg4Nw@@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Perks of Being a Wallflower', 'fullplot': 'Based on the novel written by Stephen Chbosky, this is about 15-year-old Charlie (Logan Lerman), an endearing and naive outsider, coping with first love (Emma Watson), the suicide of his best friend, and his own mental illness while struggling to find a group of people with whom he belongs. The introvert freshman is taken under the wings of two seniors, Sam and Patrick, who welcome him to the real world.', 'languages': ['English'], 'released': datetime.datetime(2012, 10, 12, 0, 0), 'directors': ['Stephen Chbosky'], 'writers': ['Stephen Chbosky (screenplay)', 'Stephen Chbosky (book)'], 'awards': {'wins': 21, 'nominations': 44, 'text': '21 wins & 44 nominations.'}, 'lastupdated': '2015-08-22 00:11:10.767000000', 'year': 2012, 'imdb': {'rating': 8.0, 'votes': 311034, 'id': 1659337}, 'countries': ['USA'], 'type': 'movie'}\n",
