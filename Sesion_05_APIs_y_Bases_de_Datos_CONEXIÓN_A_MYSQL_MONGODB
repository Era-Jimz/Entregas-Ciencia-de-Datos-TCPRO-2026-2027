            "{'_id': ObjectId('573a13dcf29313caabdb0e9e'), 'plot': 'Legendary British rock band The Rolling Stones mark their 50th year together.', 'genres': ['Documentary', 'Biography', 'Music'], 'runtime': 111, 'cast': ['Mick Jagger', 'Charlie Watts', 'Bill Wyman', 'Ron Wood'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTUzNzczMTcxMF5BMl5BanBnXkFtZTcwNjUzMTI2OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Crossfire Hurricane', 'fullplot': 'A mostly chronological look at the Rolling Stones with archive footage and recent off-camera commentary by Jagger, Richards, Watts, Wyman, Taylor, and Wood. Topics include virtually instant success (and fans\\' dangerous antics), becoming songwriters, press coverage as the anti-Beatles, Richards and Jagger\\'s drug arrest and trial, Brian Jones\\' decline and death, fleeing the tax man to the south of France, a U.S. tour and the Altamont disaster, trading the bad boys image for being fun onstage when Wood replaces Taylor,and Richards kicking smack: \"The band comes first.\" The six also talk about what makes them a great rock and roll band.', 'languages': ['English'], 'released': datetime.datetime(2012, 10, 18, 0, 0), 'directors': ['Brett Morgen'], 'writers': ['Brett Morgen'], 'awards': {'wins': 6, 'nominations': 0, 'text': 'Nominated for 4 Primetime Emmys. Another 2 wins.'}, 'lastupdated': '2015-09-14 17:30:41.927000000', 'year': 2012, 'imdb': {'rating': 7.4, 'votes': 1252, 'id': 2370140}, 'countries': ['UK', 'USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.rollingstones.com/crossfire-hurricane/', 'viewer': {'rating': 4.0, 'numReviews': 235, 'meter': 85}, 'dvd': datetime.datetime(2013, 1, 15, 0, 0), 'critic': {'rating': 7.2, 'numReviews': 26, 'meter': 88}, 'lastUpdated': datetime.datetime(2015, 9, 11, 17, 53, 5), 'rotten': 3, 'production': 'Tremelo Productions', 'fresh': 23}, 'num_mflix_comments': 0}\n",
