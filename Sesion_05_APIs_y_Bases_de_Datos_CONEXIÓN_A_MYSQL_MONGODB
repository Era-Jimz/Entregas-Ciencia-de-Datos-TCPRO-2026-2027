            "{'_id': ObjectId('573a13cef29313caabd8788e'), 'plot': \"Lucas Thomas's grandmother Caroline returns every Valentine's Day to the station where, at their then first wedding anniversary, she waved off to the pacific war theatre in 1944 naval pilot...\", 'genres': ['Drama', 'Romance'], 'runtime': 100, 'rated': 'TV-PG', 'cast': ['Jennifer Love Hewitt', 'Betty White', 'Sean Faris', 'Billy Magnussen'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY5NDMxNjkwNF5BMl5BanBnXkFtZTcwMzk3MTU0NA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Lost Valentine', 'fullplot': \"Lucas Thomas's grandmother Caroline returns every Valentine's Day to the station where, at their then first wedding anniversary, she waved off to the pacific war theatre in 1944 naval pilot Neil, officially still missing in action. Lucas, a former baseball star and reputable physiotherapist about to publish, tells the story to a station manager, who assigns the item to Susan Allison. She gets involved and befriends Caroline, but resists her crush on Lucas on account of an already soulless engagement with international reporter Andrew Hawthorne. Caroline's mild cardiac crisis seems to ruin everything.\", 'languages': ['English'], 'released': datetime.datetime(2011, 1, 30, 0, 0), 'directors': ['Darnell Martin'], 'writers': ['Maryann Ridini Spencer (teleplay)', 'Barton Taney (teleplay)', 'James Michael Pratt (book)'], 'awards': {'wins': 0, 'nominations': 5, 'text': '5 nominations.'}, 'lastupdated': '2015-08-29 00:35:10.280000000', 'year': 2011, 'imdb': {'rating': 7.5, 'votes': 3863, 'id': 1709157}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.9, 'numReviews': 500, 'meter': 77}, 'dvd': datetime.datetime(2013, 1, 8, 0, 0), 'production': 'CBS Television', 'lastUpdated': datetime.datetime(2015, 9, 16, 18, 10, 21)}}\n",
