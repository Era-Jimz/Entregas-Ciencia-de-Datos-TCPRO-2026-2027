            "{'_id': ObjectId('573a13e9f29313caabdcbafd'), 'plot': \"A behind-the-scenes look inside the case to overturn California's ban on same-sex marriage. Shot over five years, the film follows the unlikely team that took the first federal marriage equality lawsuit to the U.S. Supreme Court.\", 'genres': ['Documentary', 'Biography', 'News'], 'runtime': 109, 'cast': ['Ted Olson', 'Christopher D. Dusseault', 'Jeffrey J. Zarrillo', 'Paul T. Katami'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTAzMzYwNzM2NDheQTJeQWpwZ15BbWU4MDQzNDAxMDEx._V1_SY1000_SX677_AL_.jpg', 'title': 'The Case Against 8', 'fullplot': 'After the California Supreme Court ruled in May 2008 that same-sex couples could marry, a proposition was put to voters to amend the state constitution to define marriage as being between a man and a woman. After that proposition was passed a group decided to challenge the constitutionality of the amendment. This documentary follows the efforts of the plaintiffs and lawyers over four years as the case winds its way through the courts.', 'languages': ['English'], 'released': datetime.datetime(2014, 12, 1, 0, 0), 'directors': ['Ben Cotner', 'Ryan White'], 'writers': ['Ben Cotner (story)', 'Ryan White (story)'], 'awards': {'wins': 11, 'nominations': 10, 'text': 'Nominated for 2 Primetime Emmys. Another 9 wins & 10 nominations.'}, 'lastupdated': '2015-09-02 00:32:23.883000000', 'year': 2014, 'imdb': {'rating': 7.2, 'votes': 770, 'id': 3264024}, 'countries': ['USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13e9f29313caabdcbb2b'), 'plot': \"The story of the Soviet Union's famed Red Army hockey team through the eyes of its players.\", 'genres': ['Documentary', 'Biography', 'History'], 'runtime': 84, 'metacritic': 82, 'rated': 'PG', 'cast': ['Scotty Bowman', 'Mark Deakins', 'Viacheslav Fetisov', 'Anatoli Karpov'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjIxMDYwMTg3M15BMl5BanBnXkFtZTgwMDQ1NzQ0MzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Red Army', 'fullplot': 'Red Army is a feature documentary about the Soviet Union and the most successful dynasty in sports history: the Red Army hockey team. Told from the perspective of its captain Slava Fetisov, the story portrays his transformation from national hero to political enemy. From the USSR to Russia, the film examines how sport mirrors social and cultural movements and parallels the rise and fall of the Red Army team with the Soviet Union.', 'languages': ['English', 'Russian'], 'released': datetime.datetime(2015, 1, 29, 0, 0), 'directors': ['Gabe Polsky'], 'writers': ['Gabe Polsky (story)'], 'awards': {'wins': 3, 'nominations': 6, 'text': '3 wins & 6 nominations.'}, 'lastupdated': '2015-08-20 00:24:49.937000000', 'year': 2014, 'imdb': {'rating': 7.7, 'votes': 2224, 'id': 3264102}, 'countries': ['USA', 'Russia'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13e9f29313caabdcbd58'), 'plot': 'The story of programming prodigy and information activist Aaron Swartz, who took his own life at the age of 26.', 'genres': ['Documentary', 'Biography', 'Crime'], 'runtime': 105, 'metacritic': 72, 'cast': ['Tim Berners-Lee', 'Cindy Cohn', 'Gabriella Coleman', 'Cory Doctorow'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjgwOTgwNjQ5MV5BMl5BanBnXkFtZTgwMzk1NTQ2MTE@._V1_SY1000_SX677_AL_.jpg', 'title': \"The Internet's Own Boy: The Story of Aaron Swartz\", 'fullplot': \"The story of programming prodigy and information activist Aaron Swartz. From Swartz's help in the development of the basic internet protocol RSS to his co-founding of Reddit, his fingerprints are all over the internet. But it was Swartz's groundbreaking work in social justice and political organizing combined with his aggressive approach to information access that ensnared him in a two year legal nightmare. It was a battle that ended with the taking of his own life at the age of 26. Aaron's story touched a nerve with people far beyond the online communities in which he was a celebrity. This film is a personal story about what we lose when we are tone deaf about technology and its relationship to our civil liberties.\", 'languages': ['English'], 'released': datetime.datetime(2014, 6, 27, 0, 0), 'directors': ['Brian Knappenberger'], 'writers': ['Brian Knappenberger'], 'awards': {'wins': 3, 'nominations': 2, 'text': '3 wins & 2 nominations.'}, 'lastupdated': '2015-09-12 00:22:34.577000000', 'year': 2014, 'imdb': {'rating': 8.1, 'votes': 6630, 'id': 3268458}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13e8f29313caabdcb600'), 'plot': 'Two Kazakh brothers are about to lose their ancestral tumbledown house to corruption and nepotism while their little sister loses her capacity to breathe and their mother loses her mind.', 'genres': ['Drama'], 'runtime': 100, 'cast': ['Yerbolat Yerzhan', 'Aidyn Sakhaman', 'Aliya Zainalova', 'Bauyrzhan Kaptagai'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjA3OTE4NjE3N15BMl5BanBnXkFtZTgwNTQ4NzI2MjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Owners', 'fullplot': \"25 year-old John, his teenage brother Erbol, and their sickly 12 year-old sister Aliya, are forced to leave their house in the Kazakh city of Almaty. By luck their mother left them a house in a remote village, where they plan to prepare their comeback. But the District Officer's alcoholic brother, who has lived there illegally for 10 years, has no intention of letting the house go without a fight.\", 'countries': ['Kazakhstan'], 'released': datetime.datetime(2014, 10, 10, 0, 0), 'directors': ['Adilkhan Yerzhanov'], 'writers': ['Roelof Jan Minneboo', 'Adilkhan Yerzhanov'], 'awards': {'wins': 2, 'nominations': 7, 'text': '2 wins & 7 nominations.'}, 'lastupdated': '2015-08-16 00:48:52.650000000', 'year': 2014, 'imdb': {'rating': 6.2, 'votes': 77, 'id': 3254876}, 'type': 'movie'}\n",
