            "{'_id': ObjectId('573a13ebf29313caabdd0bc9'), 'plot': 'On his birthday, a hitman reluctantly takes on the easy task of killing a writer, only to find the job a lot more difficult than expected.', 'genres': ['Comedy', 'Thriller'], 'runtime': 96, 'cast': ['Tom Dewispelaere', 'Alex van Warmerdam', 'Maria Kraakman', 'Gene Bervoets'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMzIyNDI5MDM1N15BMl5BanBnXkFtZTgwMjM0ODk1NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Schneider vs. Bax', 'fullplot': 'Schneider, a hit man, gets a call from Mertens on the morning of his birthday. He has a rush job for Schneider who refuses it, because it is his birthday and he has promised Lucy, his wife, to help her with the preparations for the dinner party. Mertens insists that it is an important matter. When they meet in Mertens\\' office, Schneider is told that the target is Ramon Bax, a writer. He lives alone in a secluded place. \"It\\'s an easy job. With a little luck you\\'re back home before noon. \" Schneider accepts the assignment. What seems to be a simple job turns out to be more than expected.', 'languages': ['Dutch'], 'released': datetime.datetime(2015, 5, 28, 0, 0), 'directors': ['Alex van Warmerdam'], 'writers': ['Alex van Warmerdam'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-08-23 00:58:55.017000000', 'year': 2015, 'imdb': {'rating': 7.5, 'votes': 366, 'id': 3430416}, 'countries': ['Netherlands'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13ebf29313caabdd1626'), 'plot': 'A suicidal American befriends a Japanese man lost in a forest near Mt. Fuji and the two search for a way out.', 'genres': ['Drama'], 'runtime': 110, 'metacritic': 20, 'rated': 'PG-13', 'cast': ['Matthew McConaughey', 'Naomi Watts', 'Katie Aselton', 'Ken Watanabe'], 'poster': 'https://m.media-amazon.com/images/M/MV5BNDMyMTY0ODg2MV5BMl5BanBnXkFtZTgwNzI3OTY2OTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Sea of Trees', 'fullplot': \"Arthur Brennan treks into Aokigahara, known as The Sea of Trees, a mysterious dense forest at the base of Japan's Mount Fuji where people go to commit suicide. On his journey to the suicide forest, he encounters Takumi Nakamura, a Japanese man who has lost his way after attempting suicide. The two men begin a journey of reflection and survival, which affirms Arthur's will to live and reconnects him to his love for his wife.\", 'languages': ['English', 'Japanese'], 'released': datetime.datetime(2015, 5, 16, 0, 0), 'directors': ['Gus Van Sant'], 'writers': ['Chris Sparling'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-25 00:03:13.447000000', 'year': 2015, 'imdb': {'rating': 5.5, 'votes': 298, 'id': 3450900}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
