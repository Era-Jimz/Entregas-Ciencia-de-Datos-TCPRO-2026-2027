            "{'_id': ObjectId('573a13e9f29313caabdcd4ac'), 'plot': \"A documentary that resurrects the buried history of the outrageous, often brilliant women who founded the modern women's movement from 1966 to 1971.\", 'genres': ['Documentary', 'History'], 'runtime': 92, 'metacritic': 80, 'cast': ['Chude Pamela Allen', 'Alta', 'Judith Arcana', 'Nona Willis Aronowitz'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTA1ODkwODEyNDBeQTJeQWpwZ15BbWU4MDk1MjY0MDMx._V1_SY1000_SX677_AL_.jpg', 'title': \"She's Beautiful When She's Angry\", 'fullplot': \"Tells the story of the brilliant, often outrageous women who founded the feminist movement of the 1960s. They said 'the personal is political' and made a revolution: in the bedroom, in the workplace, in all spheres of life. Called threatening by the FBI, yet ignored in many histories, these women changed the world.\", 'languages': ['English'], 'released': datetime.datetime(2014, 10, 2, 0, 0), 'directors': ['Mary Dore'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-09-15 03:21:36.680000000', 'year': 2014, 'imdb': {'rating': 6.4, 'votes': 140, 'id': 3319508}, 'countries': ['USA'], 'type': 'movie'}\n",
