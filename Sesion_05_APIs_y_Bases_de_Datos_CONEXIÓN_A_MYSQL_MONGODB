            "{'_id': ObjectId('573a13dff29313caabdb72d6'), 'plot': 'A documentary that follows the money behind the rise of the Tea Party.', 'genres': ['Documentary', 'Drama'], 'runtime': 90, 'metacritic': 52, 'cast': ['David H. Koch', 'Charles G. Koch', 'Scott Walker', 'Floyd Abrams'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTEzNzM4NTUwOTZeQTJeQWpwZ15BbWU4MDkxNjIzODEx._V1_SY1000_SX677_AL_.jpg', 'title': 'Citizen Koch', 'fullplot': \"When Wisconsin Governor Scott Walker stripped state workers of their union rights in 2011, was it simply a classic face-off between labor and management, or a bold political move designed to weaken his party's political opposition? Set against the rise of the Tea Party and Occupy movements, the US Supreme Court's 2010 ruling in Citizens United, and the 2012 presidential campaign, Citizen Koch documents the consequences for democracy when private interests determine who is elected to deliver public good.\", 'languages': ['English'], 'released': datetime.datetime(2013, 1, 1, 0, 0), 'directors': ['Carl Deal', 'Tia Lessin'], 'writers': ['Carl Deal', 'Tia Lessin'], 'awards': {'wins': 1, 'nominations': 2, 'text': '1 win & 2 nominations.'}, 'lastupdated': '2015-08-28 00:07:44.783000000', 'year': 2013, 'imdb': {'rating': 6.4, 'votes': 465, 'id': 2545338}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.citizenkoch.com', 'viewer': {'rating': 3.4, 'numReviews': 385, 'meter': 53}, 'dvd': datetime.datetime(2014, 9, 2, 0, 0), 'critic': {'rating': 5.8, 'numReviews': 35, 'meter': 54}, 'boxOffice': '$0.2M', 'rotten': 16, 'production': 'Variance Films', 'lastUpdated': datetime.datetime(2015, 7, 25, 18, 58, 1), 'fresh': 19}}\n",
