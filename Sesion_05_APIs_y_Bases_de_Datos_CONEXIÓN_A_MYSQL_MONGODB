            "{'_id': ObjectId('573a13f4f29313caabde1b81'), 'plot': 'DATONG follows the life and work of a controversial Chinese Communist Mayor GENG YANBO to tell the story about how he takes a radical reform to demolish 140,000 households and relocate half...', 'genres': ['Documentary', 'Drama', 'News'], 'runtime': 89, 'title': 'The Chinese Mayor', 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQzMzAyMTk4MV5BMl5BanBnXkFtZTgwNjExNzgyNDE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['China'], 'fullplot': 'DATONG follows the life and work of a controversial Chinese Communist Mayor GENG YANBO to tell the story about how he takes a radical reform to demolish 140,000 households and relocate half a million people to give way to restoration of Ancient relic walls in order to adopt a clean economic growth from tourism and culture, which he believes will do good to DA TONG citizen in the long term. With two years in the footsteps of GENG, along with the changing ideology and confrontations from the public, the film is trying to draw a looming shape of future of China.', 'languages': ['Chinese'], 'released': datetime.datetime(2015, 1, 26, 0, 0), 'directors': ['Hao Zhou'], 'writers': ['Zhao Qi', 'Hao Zhou'], 'awards': {'wins': 2, 'nominations': 2, 'text': '2 wins & 2 nominations.'}, 'lastupdated': '2015-09-16 00:44:06.993000000', 'year': 2015, 'imdb': {'rating': 6.9, 'votes': 73, 'id': 4056808}, 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13f4f29313caabde1d9a'), 'plot': 'A young punk rock band find themselves trapped in a secluded venue after stumbling upon a horrific act of violence.', 'genres': ['Horror', 'Thriller'], 'runtime': 94, 'metacritic': 78, 'cast': ['Imogen Poots', 'Patrick Stewart', 'Alia Shawkat', 'Anton Yelchin'], 'num_mflix_comments': 1, 'title': 'Green Room', 'fullplot': 'A band straying into a secluded part of the Pacific Northwest, stumbles on to a horrific act of violence. Because they are the only witnesses, they become the targets of a terrifying gang of white power skinheads who want to make sure all the evidence is eliminated.', 'languages': ['English'], 'released': datetime.datetime(2015, 5, 17, 0, 0), 'directors': ['Jeremy Saulnier'], 'writers': ['Jeremy Saulnier'], 'awards': {'wins': 3, 'nominations': 1, 'text': '3 wins & 1 nomination.'}, 'lastupdated': '2015-09-06 00:23:02.447000000', 'year': 2015, 'imdb': {'rating': 7.4, 'votes': 124, 'id': 4062536}, 'countries': ['USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13f4f29313caabde1e79'), 'plot': \"Jennie Stanton (Torrey DeVitto) throws the best Christmas parties every year for her company, Petra's Parties. Things are a little different this year, as Petra is retiring and looks to the...\", 'genres': ['Drama', 'Family'], 'countries': ['USA'], 'cast': ['Torrey DeVitto', 'Steve Lund', 'Linda Thorson', 'Kalinka Petrie'], 'title': 'Best Christmas Party Ever', 'fullplot': 'Jennie Stanton (Torrey DeVitto) throws the best Christmas parties every year for her company, Petra\\'s Parties. Things are a little different this year, as Petra is retiring and looks to the next generation to take over. Jennie thinks she has her new job in the bag, until Petra\\'s charismatic nephew, Nick (Steve Lund), shows up as \"seasonal help\" and his natural talent and confidence clashes with Jennie\\'s stern work ethic and traditional values. The pair battle it out for the top job with unmistakable chemistry and symmetry, but when the new owners of the legendary Tyrell\\'s Toys put the bottom line before Christmas spirit, threatening to pull the plug on Tyrell\\'s Toys\\' annual Christmas party for the community, Jennie and Nick are forced to work together to throw the greatest Christmas party ever.', 'languages': ['English'], 'released': datetime.datetime(2014, 12, 13, 0, 0), 'directors': ['John Bradshaw'], 'writers': ['Lewis Chesler (story)', 'Fariba Cain (story)', 'Robert Vaughn', 'Kevin Commins'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-04 00:33:42.990000000', 'year': 2014, 'imdb': {'rating': 6.7, 'votes': 290, 'id': 4065316}, 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13f4f29313caabde218e'), 'plot': 'A guy meets a girl and they go on an amazing adventure together.', 'genres': ['Drama', 'Romance'], 'runtime': 109, 'cast': ['Kris Wu', 'Likun Wang', 'Jinglei Xu', 'Gordon Alexander'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjEyNTI3MDI2N15BMl5BanBnXkFtZTgwNDEyMzYzNDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Somewhere Only We Know', 'fullplot': \"Jin Tian, a young woman who recently got dumped by her fiance and lost her grandmother, Chen Lanxin. Feeling heartbroken, she travels to Prague, the place where her grandmother once spent years of her life. In her grandmother's belongings she finds a letter from 1970. In Prague, Jin Tian meets Peng Zeyang, a young single father who lives with his daughter and mother. The two develop a mutual attraction during their journey on searching Josef Novak, her grandmother's past lover.\", 'languages': ['Mandarin', 'English'], 'released': datetime.datetime(2015, 2, 13, 0, 0), 'directors': ['Jinglei Xu'], 'writers': ['Shuo Wang', 'Yun Wang', 'Jinglei Xu', 'Meng Zhao'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-25 00:18:07.773000000', 'year': 2015, 'imdb': {'rating': 5.2, 'votes': 316, 'id': 4074958}, 'countries': ['China'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13f4f29313caabde13c4'), 'plot': 'Witold just failed his law-school exams and Fuchs has just quit his job at a Parisian fashion company. Arriving for a few days away at a so-called family guesthouse, they are greeted by a ...', 'genres': ['Drama'], 'runtime': 103, 'title': 'Cosmos', 'countries': ['France', 'Portugal'], 'fullplot': \"Witold just failed his law-school exams and Fuchs has just quit his job at a Parisian fashion company. Arriving for a few days away at a so-called family guesthouse, they are greeted by a series of unsettling omens: a sparrow hanging in the forest, then a piece of wood in the same condition, and finally signs on the ceiling and in the garden. In this guest house there is also a baleful mouth, that of the maid, and a perfect mouth, that of the young woman of the house with whom Witold falls madly in love. Unfortunately, she has just married an architect of the most respectable sort. But is the young woman equally respectable? The third hanging, that of the cat, is Witold's doing. Why did he do it? And above all - will the fourth hanging be that of a human?\", 'languages': ['French'], 'cast': ['Sabine Azèma', 'Jean-Franèois Balmer', 'Jonathan Genet', 'Johan Libèreau'], 'directors': ['Andrzej Zulawski'], 'writers': ['Witold Gombrowicz (book)', 'Andrzej Zulawski'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-08-08 00:17:29.897000000', 'year': 2015, 'imdb': {'rating': '', 'votes': '', 'id': 4035268}, 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13f4f29313caabde1c25'), 'plot': \"INDIA's DAUGHTER is the story of the short life, and brutal gang rape and murder in Delhi in December 2012 of an exceptional and inspiring young woman. The rape of the 23 year old medical ...\", 'genres': ['Documentary', 'Crime', 'News'], 'runtime': 63, 'cast': ['Asha Devi', 'Badri Singh', 'Satendra', 'Mukesh Singh'], 'title': \"India's Daughter\", 'fullplot': \"INDIA's DAUGHTER is the story of the short life, and brutal gang rape and murder in Delhi in December 2012 of an exceptional and inspiring young woman. The rape of the 23 year old medical student by 6 men on a moving bus, and her death, sparked unprecedented protests and riots throughout India and led to the first glimmers of a change of mindset. Interwoven into the story line are the lives, values and mindsets of the rapists whom the film makers have had exclusive and unprecedented access to interview before they hang. The film examines the society and values which spawn such violent acts, and makes an optimistic and impassioned plea for change.\", 'languages': ['English', 'Hindi'], 'released': datetime.datetime(2015, 3, 9, 0, 0), 'directors': ['Leslee Udwin'], 'writers': ['Leslee Udwin'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-15 04:50:37.197000000', 'year': 2015, 'imdb': {'rating': 8.1, 'votes': 918, 'id': 4058426}, 'countries': ['UK', 'India'], 'type': 'movie', 'num_mflix_comments': 0}\n",
