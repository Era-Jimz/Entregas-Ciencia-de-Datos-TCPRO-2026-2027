            "{'_id': ObjectId('573a13e9f29313caabdccb5b'), 'plot': 'A fancy garden party turns into upper class prey when a colony of killer wasps mutates into seven foot tall predators.', 'genres': ['Comedy', 'Horror'], 'runtime': 87, 'metacritic': 46, 'cast': ['Clifton Collins Jr.', 'Jessica Cook', 'Tony de Maeyer', 'Lance Henriksen'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BNzAyMDA3OTYyNl5BMl5BanBnXkFtZTgwMTgwODM2NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Stung', 'fullplot': \"Mrs. Perch, an elderly, wealthy lady from rural America, is throwing a fancy garden party at her remote country villa. Same procedure as every year - except this time her illegally imported plant fertilizer seeps into the ground. Subsequently, a local species of killer wasps that usually lay their eggs into other insects mutates into 7 ft tall predators. And the celebrating upper class company provides just the right kind of prey. It's up to Paul and Julia, the two catering staffers, to stop the creatures, fight for their lives, and incidentally getting their stumbling romance in order.\", 'languages': ['English'], 'released': datetime.datetime(2015, 7, 3, 0, 0), 'directors': ['Benni Diez'], 'writers': ['Adam Aresty'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-14 00:01:09.127000000', 'year': 2015, 'imdb': {'rating': 5.0, 'votes': 1355, 'id': 3300572}, 'countries': ['Germany', 'USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13e9f29313caabdccc55'), 'plot': 'Santiago and Eugenio are more than friends, they are life long business partners. They understand each other without words, they care for each other, they need each other. One day Eugenio ...', 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 92, 'cast': ['Fabièn Arenillas', 'Alejandro Awada', 'Sergio Boris', 'Ponchy Brusse'], 'poster': 'https://m.media-amazon.com/images/M/MV5BOTU5NDkyMzE1Ml5BMl5BanBnXkFtZTgwNDI0MDE2MjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Mystery of Happiness', 'fullplot': \"Santiago and Eugenio are more than friends, they are life long business partners. They understand each other without words, they care for each other, they need each other. One day Eugenio disappears without leaving any clues behind. Santiago immediately notices his absence, but only realizes what have happened when Eugenio's wife, Laura, lost and hopeless assures him that Eugenio has left. Santiago and Laura begin a journey in order to find him and end up discovering that they prefer to stay together in this quest rather than finding out where he is. 'The Mystery of Happiness' is a film about love, but goes beyond it, it pushes boundaries, it explores the idea of loyalty and estrangement, and it definitely puts dreams over long lost promises.\", 'languages': ['Spanish'], 'released': datetime.datetime(2014, 1, 16, 0, 0), 'directors': ['Daniel Burman'], 'writers': ['Daniel Burman', 'Sergio Dubcovsky'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-18 00:55:05.890000000', 'year': 2014, 'imdb': {'rating': 6.1, 'votes': 456, 'id': 3302594}, 'countries': ['Argentina', 'Brazil'], 'type': 'movie', 'num_mflix_comments': 0}\n",
