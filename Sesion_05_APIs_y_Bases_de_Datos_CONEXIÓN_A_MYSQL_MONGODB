            "{'_id': ObjectId('573a13cdf29313caabd84b64'), 'plot': \"Jay doesn't believe in love Stories, and Simran, is a girl who's in love with the idea of Love itself.\", 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 129, 'cast': ['Imran Khan', 'Sonam Kapoor', 'Sammir Dattani', 'Samir Soni'], 'poster': 'https://m.media-amazon.com/images/M/MV5BZTRlMTAyNmQtZjA2Zi00MmMzLThlZjItODRmZWJhNTNiYWYxXkEyXkFqcGdeQXVyODE5NzE3OTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'I Hate Luv Storys', 'fullplot': \"Born from a Gujarati mother and a Punjabi father, Mumbai-based Bollywood Art Director, Simran, is in love with her childhood sweetheart, Raj Dholakia, who is also her mother's choice. Then her employer, Veer Kapoor, assigns a slacker-Casanova, Jay Dhingra, to work as her subordinate. Jay turns on his charm - albeit in vain - and almost gets fired. Both eventually patch-up and get engrossed in the making of a movie 'Pyar Pyar Pyar'. During the filming, Simran admits that she has fallen in love with him, and even breaks up with Raj, but Jay rejects her. Heartbroken, she returns to Raj - who welcomes her back, and they are all set to wed. It is then Jay realizes that he may be in love, and wants to meet and apologize to her.\", 'languages': ['Hindi'], 'released': datetime.datetime(2010, 7, 2, 0, 0), 'directors': ['Punit Malhotra'], 'writers': ['Vishal Dadlani (lyrics)', 'Kumaar (lyrics)', 'Punit Malhotra (story)'], 'awards': {'wins': 0, 'nominations': 9, 'text': '9 nominations.'}, 'lastupdated': '2015-08-17 00:59:22.080000000', 'year': 2010, 'imdb': {'rating': 5.6, 'votes': 5250, 'id': 1667838}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'website': 'http://www.ihateluvstorys.com/', 'viewer': {'rating': 3.0, 'numReviews': 3904, 'meter': 43}, 'dvd': datetime.datetime(2010, 12, 21, 0, 0), 'boxOffice': '$0.8M', 'production': 'UTV Communications', 'lastUpdated': datetime.datetime(2015, 9, 17, 17, 46, 41)}, 'num_mflix_comments': 0}\n",
