            "{'_id': ObjectId('573a13f2f29313caabddd82b'), 'plot': \"Life changes for Malcolm, a geek who's surviving life in a tough neighborhood, after a chance invitation to an underground party leads him and his friends into a Los Angeles adventure.\", 'genres': ['Comedy', 'Crime', 'Drama'], 'runtime': 103, 'metacritic': 72, 'rated': 'R', 'cast': ['Rakim Mayers', 'Blake Anderson', 'Bruce Beatty', \"De'aundre Bonds\"], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjA3MjYyNTk0Nl5BMl5BanBnXkFtZTgwODc1NzQ1NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Dope', 'fullplot': \"A coming of age comedy/drama for the post hip hop generation. Malcolm is a geek, carefully surviving life in The Bottoms, a tough neighborhood in Inglewood, CA filled gangsters and drugs dealers, while juggling his senior year of college applications, interviews and the SAT. His dream is to attend Harvard. A chance invitation to a big underground party leads Malcolm and his friends into a, only in Los Angeles, gritty adventure filed with offbeat characters and bad choices. If Malcolm can persevere, he'll go from being a geek, to being dope, to ultimately being himself.\", 'languages': ['English'], 'released': datetime.datetime(2015, 6, 19, 0, 0), 'directors': ['Rick Famuyiwa'], 'writers': ['Rick Famuyiwa'], 'awards': {'wins': 1, 'nominations': 4, 'text': '1 win & 4 nominations.'}, 'lastupdated': '2015-08-26 00:01:44.197000000', 'year': 2015, 'imdb': {'rating': 7.6, 'votes': 4883, 'id': 3850214}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
