            "{'_id': ObjectId('573a13cff29313caabd8a7e5'), 'plot': \"Identical twins Andy and Pete Goodwynn have always been there for each other. But in a cruel twist of fate-orchestrated by the town's most powerful family-their lives are forever altered. ...\", 'genres': ['Drama'], 'runtime': 118, 'rated': 'PG-13', 'cast': ['Michael Rooker', 'Ray Wise', 'Travis Tritt', 'W. Earl Brown'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMzNjMjhhMzktNmM5MC00MjZhLTgzODEtYWM5OTBkNWE1OWY1XkEyXkFqcGdeQXVyMTMxMTY0OTQ@._V1_SY1000_SX677_AL_.jpg', 'title': \"Brother's Keeper\", 'fullplot': \"Identical twins Andy and Pete Goodwynn have always been there for each other. But in a cruel twist of fate-orchestrated by the town's most powerful family-their lives are forever altered. Can the brothers gain vengeance on those who have taken away from them all that matters? While revenge may seem sweet, BROTHER'S KEEPER is a powerful reminder that only forgiveness can truly heal.\", 'languages': ['English'], 'released': datetime.datetime(2015, 5, 29, 0, 0), 'directors': ['T.J. Amato', 'Josh Mills'], 'writers': ['Briana Hartman', 'Josh Mills (developer)'], 'awards': {'wins': 2, 'nominations': 3, 'text': '2 wins & 3 nominations.'}, 'lastupdated': '2015-08-19 00:45:58.283000000', 'year': 2013, 'imdb': {'rating': 5.2, 'votes': 228, 'id': 1748016}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.4, 'numReviews': 164, 'meter': 90}, 'dvd': datetime.datetime(2015, 8, 4, 0, 0), 'website': 'http://brotherskeeperfilm.com/', 'production': 'Desert Wind Releasing', 'lastUpdated': datetime.datetime(2015, 9, 10, 18, 32, 4)}, 'num_mflix_comments': 0}\n",
