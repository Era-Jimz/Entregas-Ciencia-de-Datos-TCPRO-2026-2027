            "{'_id': ObjectId('573a13cbf29313caabd808d4'), 'plot': 'Christian is a Copenhagen wine seller on the brink of bankruptcy. Equally unsuccessful in just about every other aspect of life, it has been 17months since his wife Anna left him. Anna ...', 'genres': ['Comedy'], 'runtime': 99, 'cast': ['Mikael Bertelsen', 'Anders W. Berthelsen', 'Jamie Morton', 'Paprika Steen'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjAzNjUzMzU3NF5BMl5BanBnXkFtZTcwMDQ4OTc0NA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Superclèsico', 'fullplot': \"Christian is a Copenhagen wine seller on the brink of bankruptcy. Equally unsuccessful in just about every other aspect of life, it has been 17months since his wife Anna left him. Anna works as a soccer agent in Buenos Aires and now lives a life of luxury with Argentina's top player Juan Diaz. Then one day Christian and their 16-year-old son Oscar get on a plane to Buenos Aires. Christian arrives under the pretense of wanting to sign the divorce papers, but in truth, he wants to try to win Anna back.\", 'languages': ['Danish', 'Spanish', 'English'], 'released': datetime.datetime(2011, 3, 17, 0, 0), 'directors': ['Ole Christian Madsen'], 'writers': ['Ole Christian Madsen (screenplay)', 'Anders Frithiof August (screenplay)'], 'awards': {'wins': 2, 'nominations': 16, 'text': '2 wins & 16 nominations.'}, 'lastupdated': '2015-09-02 00:39:41.663000000', 'year': 2011, 'imdb': {'rating': 6.4, 'votes': 1893, 'id': 1609492}, 'countries': ['Denmark'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cbf29313caabd8097a'), 'plot': \"Barbie stars as Merliah, a surfer who learns a shocking secret: she's a mermaid! She and her dolphin friend set out for an undersea adventure to rescue her mother, the queen of Oceana.\", 'genres': ['Animation', 'Family', 'Fantasy'], 'runtime': 75, 'cast': ['Kelly Sheridan', 'Kathleen Barr', 'Tabitha St. Germain', 'Peter Mel'], 'num_mflix_comments': 2, 'poster': 'https://m.media-amazon.com/images/M/MV5BZWUwNDI2YzUtMGYyYy00MWQ2LTljYmMtMDg3ZjZlYjRkOWFlXkEyXkFqcGdeQXVyNDgyODgxNjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Barbie in a Mermaid Tale', 'fullplot': \"Barbie stars as Merliah, a surfer who learns a shocking secret: she's a mermaid! She and her dolphin friend set out for an undersea adventure to rescue her mother, the queen of Oceana.\", 'languages': ['English'], 'released': datetime.datetime(2010, 3, 9, 0, 0), 'directors': ['Adam Wood'], 'writers': ['Elise Allen (screenplay)'], 'awards': {'wins': 1, 'nominations': 3, 'text': '1 win & 3 nominations.'}, 'lastupdated': '2015-08-21 00:32:59', 'year': 2010, 'imdb': {'rating': 5.9, 'votes': 892, 'id': 1610301}, 'countries': ['USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13cbf29313caabd80a07'), 'plot': 'Shruti and Bittoo decide to start a wedding planning company together after they graduate from university, but romance gets in the way of business.', 'genres': ['Drama', 'Romance'], 'runtime': 139, 'cast': ['Ranveer Singh', 'Anushka Sharma', 'Ranjit Batra', 'Manu Rishi Chadha'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BOTJlMWYwYTYtZGFjYS00NmY1LWFhNGEtNWMxZTVmZGY1N2MwXkEyXkFqcGdeQXVyNTkzNDQ4ODc@._V1_SY1000_SX677_AL_.jpg', 'title': 'Wedding Planners', 'fullplot': \"After Delhi-based slacker-collegian, Bittoo Sharma's father asks him to return home to work in the sugar-cane fields, he refuses and decides to partner with career-minded wedding planner, Janakpuri-based Shruti Kakkar. She refuses to have to do anything with him, but after he impresses her, she partners with him, they set up 'Shaadi Mubarak' and begin organizing small wedding celebrations with struggling restaurateur and florist, Rajinder Singh and Maqbool respectfully. The duo hit big time after they organize a wedding party at Sainik Farm and begin to have dreams of bettering their lives. It is then Shruti realizes that she has fallen in love with Bittoo, and is embittered when he does not reciprocate. This bitterness gets worse, and the duo split up, with Bittoo opening 'Happy Weddings' - resulting in a downward spiral of their performance. With creditors hovering over them, no money coming in, Shruti finally gives way to her parents' wishes and agrees to get married to Dubai-based Chetan.\", 'languages': ['Hindi', 'English', 'Panjabi'], 'released': datetime.datetime(2010, 12, 10, 0, 0), 'directors': ['Maneesh Sharma'], 'writers': ['Amitabh Bhattacharya (lyrics)', 'Habib Faisal (screenplay)', 'Maneesh Sharma (story)'], 'awards': {'wins': 8, 'nominations': 11, 'text': '8 wins & 11 nominations.'}, 'lastupdated': '2015-08-19 00:03:54.407000000', 'year': 2010, 'imdb': {'rating': 7.4, 'votes': 6378, 'id': 16