            "{'_id': ObjectId('573a13d5f29313caabd9c1bc'), 'fullplot': \"Jiro dreams of flying and designing beautiful airplanes, inspired by the famous Italian aeronautical designer Caproni. Nearsighted from a young age and unable to be a pilot, Jiro joins a major Japanese engineering company in 1927 and becomes one of the world's most innovative and accomplished airplane designers. The film chronicles much of his life, depicting key historical events, including the Great Kanto Earthquake of 1923, the Great Depression, the tuberculosis epidemic and Japan's plunge into war. Jiro meets and falls in love with Nahoko, and grows and cherishes his friendship with his colleague Honjo.\", 'imdb': {'rating': 7.8, 'votes': 34921, 'id': 2013293}, 'year': 2013, 'plot': 'A look at the life of Jiro Horikoshi, the man who designed Japanese fighter planes during World War II.', 'genres': ['Animation', 'Biography', 'Drama'], 'rated': 'PG-13', 'metacritic': 83, 'title': 'The Wind Rises', 'lastupdated': '2015-09-13 00:17:46.493000000', 'languages': ['Japanese', 'German', 'Italian', 'French'], 'writers': ['Hayao Miyazaki (comic)', 'Hayao Miyazaki (screenplay)', 'Mike Jones (screenplay)'], 'type': 'movie', 'tomatoes': {'website': 'http://thewindrisesmovie.tumblr.com/', 'viewer': {'rating': 4.1, 'numReviews': 21368, 'meter': 85}, 'dvd': datetime.datetime(2014, 11, 17, 0, 0), 'critic': {'rating': 7.9, 'numReviews': 158, 'meter': 89}, 'boxOffice': '$5.2M', 'consensus': 'The Wind Rises is a fittingly bittersweet swan song for director Hayao Miyazaki.', 'rotten': 18, 'production': 'Walt Disney Pictures', 'lastUpdated': datetime.datetime(2015, 8, 22, 18, 4, 31), 'fresh': 140}, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTU4NDg0MzkzNV5BMl5BanBnXkFtZTgwODA3Mzc1MDE@._V1_SY1000_SX677_AL_.jpg', 'num_mflix_comments': 0, 'released': datetime.datetime(2014, 2, 21, 0, 0), 'awards': {'wins': 35, 'nominations': 38, 'text': 'Nominated for 1 Oscar. Another 34 wins & 38 nominations.'}, 'countries'