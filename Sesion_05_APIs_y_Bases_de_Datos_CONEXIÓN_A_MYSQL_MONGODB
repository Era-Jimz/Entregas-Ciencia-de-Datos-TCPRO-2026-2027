            "{'_id': ObjectId('573a13d8f29313caabda598e'), 'plot': 'An account of slain Human Rights lawyer Shahid Azmi, an ordinary citizen with an extraordinary commitment to justice.', 'genres': ['Biography', 'Crime', 'Drama'], 'runtime': 129, 'cast': ['Rajkummar Rao', 'Prabhleen Sandhu', 'Mohammed Zeeshan Ayyub', 'Baljinder Kaur'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTYyMDE1NjQ1Nl5BMl5BanBnXkFtZTgwMDAyMTUzMDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Shahid', 'fullplot': 'Shahid traces the true story of slain human rights activist and lawyer Shahid Azmi. From attempting to become a terrorist to being wrongly imprisoned under a draconian anti-terrorism law to becoming a criminal lawyer Shahid traces the inspiring personal journey of a boy who became an unlikely messiah for human rights while following the rise of communal violence in India. This story of an impoverished Muslim struggling to come to terms with injustice, inequality and rising above his circumstances is an inspiring testament to the human spirit.', 'languages': ['Hindi'], 'released': datetime.datetime(2013, 10, 18, 0, 0), 'directors': ['Hansal Mehta'], 'writers': ['Sameer Gautam Singh (screenplay)', 'Sameer Gautam Singh', 'Sameer Gautam Singh (story)', 'Hansal Mehta (screenplay)', 'Hansal Mehta (story)'], 'awards': {'wins': 9, 'nominations': 7, 'text': '9 wins & 7 nominations.'}, 'lastupdated': '2015-09-02 00:26:38.647000000', 'year': 2012, 'imdb': {'rating': 8.4, 'votes': 4664, 'id': 2181831}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.2, 'numReviews': 212, 'meter': 95}, 'dvd': datetime.datetime(2013, 12, 2, 0, 0), 'production': 'UTV', 'boxOffice': '$12.2k', 'lastUpdated': datetime.datetime(2015, 9, 14, 21, 29, 24)}}\n",
