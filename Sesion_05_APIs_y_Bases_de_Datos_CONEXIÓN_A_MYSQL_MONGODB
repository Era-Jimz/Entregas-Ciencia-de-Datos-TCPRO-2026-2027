            "{'_id': ObjectId('573a13dbf29313caabdaee4d'), 'plot': 'In the summer of 1898, a small group of German compatriots head into the hostile northern interior of British Columbia in search for gold at the height of the Klondike Gold Rush.', 'genres': ['Adventure', 'Drama', 'Western'], 'runtime': 101, 'cast': ['Nina Hoss', 'Marko Mandic', 'Peter Kurth', 'Uwe Bohm'], 'poster': 'https://m.media-amazon.com/images/M/MV5BOTU0MTA3NzItOGI2MS00M2VhLWFlMjUtYTk4OTRiZTYwNTc3XkEyXkFqcGdeQXVyNDkzNTM2ODg@._V1_SY1000_SX677_AL_.jpg', 'title': 'Gold', 'fullplot': \"During the Klondike Gold Rush of 1898, Emily Meyer joins a group of German immigrants who travel to the Far North in search of gold deposits. The seven apprentice gold-diggers, who have no real idea of what awaits them, leave the town of Ashcroft, the end of the railway line and set off for their long journey. As they sink into the wilderness of Canada's wide-open paces, fatigue is felt. Worse, the maps become uncertain. As a result, doubt sets in and conflicts burst forth...\", 'languages': ['German', 'English'], 'released': datetime.datetime(2013, 8, 15, 0, 0), 'directors': ['Thomas Arslan'], 'writers': ['Thomas Arslan (screenplay)'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-09-07 00:03:29.693000000', 'year': 2013, 'imdb': {'rating': 6.3, 'votes': 630, 'id': 2338846}, 'countries': ['Germany', 'Canada'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.0, 'numReviews': 46, 'meter': 38}, 'dvd': datetime.datetime(2014, 5, 19, 0, 0), 'website': 'http://www.screenmediafilms.net/', 'production': 'Screen Media Films', 'lastUpdated': datetime.datetime(2015, 9, 10, 18, 46, 15)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13dbf29313caabdae841'), 'fullplot': \"DEEPSEA CHALLENGE 3D follows the dramatic story of James Cameron's odyssey as he undertakes an expedition to the deepest part of the ocean. This is a journey of historic proportion and risk. The film will mesmerize viewers of all ages with the thrill of true discovery and the allure of the unknown, of new life forms, and of vistas never before captured on camera - all right here on planet Earth.\", 'imdb': {'rating': 6.7, 'votes': 848, 'id': 2332883}, 'year': 2014, 'plot': \"A 3D documentary chronicling filmmaker James Cameron's diving expeditions in his Deepsea Challenger submersible.\", 'genres': ['Documentary'], 'rated': 'PG', 'metacritic': 58, 'title': 'Deepsea Challenge 3D', 'lastupdated': '2015-08-16 00:10:57.120000000', 'languages': ['English'], 'writers': ['John Garvin'], 'type': 'movie', 'tomatoes': {'website': 'http://deepseachallenge.com/', 'viewer': {'rating': 3.2, 'numReviews': 730, 'meter': 49}, 'critic': {'rating': 6.3, 'numReviews': 33, 'meter': 67}, 'boxOffice': '$0.1M', 'consensus': 'Deepsea Challenge 3D is more of a tribute to director James Cameron than a true nature documentary, but it still boasts enough passion and visual thrills to make for an immersive viewing experience.', 'rotten': 11, 'production': 'National Geographic', 'lastUpdated': datetime.datetime(2015, 8, 31, 19, 47), 'fresh': 22}, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg5Mjk0NTY3MV5BMl5BanBnXkFtZTgwMjI0OTIxMjE@._V1_SY1000_SX677_AL_.jpg', 'num_mflix_comments': 0, 'released': datetime.datetime(2014, 8, 21, 0, 0), 'awards': {'wins': 0, 'nominations': 7, 'text': '7 nominations.'}, 'countries': ['USA'], 'cast': ['James Cameron', 'Frank Lotito', 'Paul Henri', 'Lachlan Woods'], 'directors': ['John Bruno', 'Ray Quint', 'Andrew Wight'], 'runtime': 90}\n",
            "{'_id': ObjectId('573a13dbf29313caabdae9c2'), 'plot': 'The story of Oscar Grant III, a 22-year-old Bay Area resident, who crosses paths with friends, enemies, family, and strangers on the last day of 2008.', 'genres': ['Biography', 'Drama', 'Romance'], 'runtime': 85, 'metacritic': 85, 'rated': 'R', 'cast': ['Michael B. Jordan', 'Melonie Diaz', 'Octavia Spencer', 'Kevin Durand'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQ0OTU1MDkxMF5BMl5BanBnXkFtZTcwNjI5OTA3OQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Fruitvale Station', 'fullplot': \"This is the true story of Oscar, a 22-year-old Bay Area resident who wakes up on the morning of December 31, 2008 and feels something in the air. Not sure what it is, he takes it as a sign to get a head start on his resolutions: being a better son to his mother, whose birthday falls on New Year's Eve, being a better partner to his girlfriend, who he hasn't been completely honest with as of late, and being a better father to T, their beautiful 4 year old daughter. He starts out well, but as the day goes on, he realizes that change is not going to come easy. He crosses paths with friends, family, and strangers, each exchange showing us that there is much more to Oscar than meets the eye. But it would be his final encounter of the day, with police officers at the Fruitvale BART station that would shake the Bay Area to its very core, and cause the entire nation to be witnesses to the story of Oscar Grant.\", 'languages': ['English'], 'released': datetime.datetime(2013, 7, 26, 0, 0), 'directors': ['Ryan Coogler'], 'writers': ['Ryan Coogler'], 'awards': {'wins': 41, 'nominations': 50, 'text': '41 wins & 50 nominations.'}, 'lastupdated': '2015-09-07 00:07:59.990000000', 'year': 2013, 'imdb': {'rating': 7.5, 'votes': 44650, 'id': 2334649}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.fruitvalefilm.com/', 'viewer': {'rating': 4.1, 'numReviews': 37300, 'meter': 87}, 'dvd': datetime.datetime(2014