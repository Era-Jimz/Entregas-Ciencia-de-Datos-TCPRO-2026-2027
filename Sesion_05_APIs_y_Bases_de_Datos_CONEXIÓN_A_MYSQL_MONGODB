            "{'_id': ObjectId('573a13e7f29313caabdc831b'), 'plot': 'A socially awkward teenage math prodigy finds new confidence and new friendships when he lands a spot on the British squad at the International Mathematics Olympiad.', 'genres': ['Comedy', 'Drama'], 'runtime': 111, 'metacritic': 66, 'cast': ['Asa Butterfield', 'Rafe Spall', 'Sally Hawkins', 'Eddie Marsan'], 'num_mflix_comments': 2, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjAxMjkxODc0N15BMl5BanBnXkFtZTgwNzU4NDY1MzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'A Brilliant Young Mind', 'fullplot': \"In a world difficult to comprehend, Nathan struggles to connect with those around him - most of all his loving mother - but finds comfort in numbers. When Nathan is taken under the wing of unconventional and anarchic teacher, Mr. Humphreys, the pair forge an unusual friendship and Nathan's talents win him a place on the UK team at the International Mathematics Olympiad. From suburban England to bustling Taipei and back again, Nathan builds complex relationships as he is confronted by the irrational nature of love.\", 'languages': ['English'], 'released': datetime.datetime(2015, 9, 11, 0, 0), 'directors': ['Morgan Matthews'], 'writers': ['James Graham'], 'awards': {'wins': 3, 'nominations': 6, 'text': '3 wins & 6 nominations.'}, 'lastupdated': '2015-09-12 00:13:41.860000000', 'year': 2014, 'imdb': {'rating': 7.2, 'votes': 7960, 'id': 3149038}, 'countries': ['UK'], 'type': 'movie', 'tomatoes': {'website': 'http://www.xplusymovie.com/', 'viewer': {'rating': 4.0, 'numReviews': 2887}, 'critic': {'rating': 6.9, 'numReviews': 44, 'meter': 93}, 'lastUpdated': datetime.datetime(2015, 9, 10, 18, 10, 28), 'consensus': 'A Brilliant Young Mind is tender and perceptive -- and intelligent enough to find a wealth of dramatic riches buried under well-trod narrative ground.', 'rotten': 3, 'production': 'Samuel Goldwyn Films', 'fresh': 41}}\n",
            "{'_id': ObjectId('573a13e7f29313caabdc89dd'), 'plot': 'Residents of a retirement home build a machine for self-euthanasia in order to help their terminally ill friend, though they are faced with a series of dilemmas when rumors of the machine begin to spread.', 'genres': ['Comedy', 'Drama'], 'runtime': 95, 'metacritic': 71, 'cast': [\"Ze'ev Revach\", 'Levana Finkelstein', 'Aliza Rosen', 'Ilan Dar'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQ4OTY3NzAyM15BMl5BanBnXkFtZTgwOTM3Mzk0NDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Farewell Party', 'fullplot': 'THE FAREWELL PARTY is a compassionate dark comedy about friendship and knowing when to say goodbye. A group of friends at a Jerusalem retirement home build a machine for self-euthanasia in order to help their terminally ill friend. When rumors of the machine begin to spread, more and more people ask for their help, and the friends are faced with an emotional dilemma.', 'languages': ['Hebrew'], 'released': datetime.datetime(2015, 5, 22, 0, 0), 'directors': ['Tal Granit', 'Sharon Maymon'], 'writers': ['Tal Granit', 'Sharon Maymon'], 'awards': {'wins': 9, 'nominations': 11, 'text': '9 wins & 11 nominations.'}, 'lastupdated': '2015-09-12 00:23:40.420000000', 'year': 2014, 'imdb': {'rating': 7.2, 'votes': 626, 'id': 3163304}, 'countries': ['Israel', 'Germany'], 'type': 'movie', 'tomatoes': {'website': 'http://www.2teamproductions.com/en/productions/completed/the-farewell-party-film', 'viewer': {'rating': 3.9, 'numReviews': 874, 'meter': 81}, 'dvd': datetime.datetime(2015, 9, 22, 0, 0), 'critic': {'rating': 7.0, 'numReviews': 28, 'meter': 93}, 'lastUpdated': datetime.datetime(2015, 8, 30, 18, 51, 9), 'rotten': 2, 'production': 'Samuel Goldwyn Films', 'fresh': 26}}\n",
            "{'_id': ObjectId('573a13e7f29313caabdc8c6e'), 'plot': 'U.K. gay activists work to help miners during their lengthy strike of the National Union of Mineworkers in the summer of 1984.', 'genres': ['Biography', 'Comedy', 'Drama'], 'runtime': 119, 'metacritic': 79, 'rated': 'R', 'cast': ['Ben Schnetzer', 'Abram Rooney', 'Jim McManus', 'George MacKay'], 'num_mflix_comments': 2, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTU2OTcyOTE3MF5BMl5BanBnXkFtZTgwNTg5Mjc1MjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Pride', 'fullplot': \"In 1984 20 year old closet gay Joe hesitantly arrives in London from Bromley for his first Gay Pride march and is taken under the collective wing of a group of gay men and Lesbian Steph, who meet at flamboyant Jonathan and his Welsh partner Gethin's Soho bookshop. Not only are gays being threatened by Thatcher but the miners are on strike in response to her pit closures and Northern Irish activist Mark Ashton believes gays and miners should show solidarity. Almost by accident a mini-bus full of gays find themselves in the Welsh village of Onllwyn in the Dulais valley and through their sincere fund raising and Jonathan's nifty disco moves persuade most of the community that they are on the same side. When a bigot tries to sabotage the partnership with a tabloid smear Mark turns it back on her with a hugely successful benefit concert to which most of the villagers, now thoroughly in tune with their gay friends, turn up. The miners are defeated and return to work but at the Pride march the following year a vast contingent of miners show up to repay their comrades with their show of support.\", 'languages': ['English', 'Welsh'], 'released': datetime.datetime(2014, 9, 12, 0, 0), 'directors': ['Matthew Warchus'], 'writers': ['Stephen Beresford'], 'awards': {'wins': 9, 'nominations': 15, 'text': 'Nominated for 1 Golden Globe. Another 8 wins & 15 nominations.'}, 'lastupdated': '2015-08-17 00:01:53.937000000', 'year': 2014, 'imdb': {'rating'