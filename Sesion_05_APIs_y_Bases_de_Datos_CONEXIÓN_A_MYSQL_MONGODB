            "{'_id': ObjectId('573a13cdf29313caabd846d0'), 'plot': 'A killer bandit decides to become a politician in order to avenge deaths in his family.', 'genres': ['Action', 'Biography', 'Crime'], 'runtime': 125, 'cast': ['Vivek Oberoi', 'Shatrughan Sinha', 'Sudeep', 'Abhimanyu Singh'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BNDU1NjAxNTMxNF5BMl5BanBnXkFtZTgwNDUzMjk4NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Rakhta Charitra', 'fullplot': \"Rakta Charitra is a biographical tale of Paritala Ravi from Andhra Pradesh, a prime accused in a number of murder cases. It is the story of a man's phenomenal rise to power and a story of the most intense blood curdling conflict ever heard of between two individuals. Moreover, the story is also the ultimate statement on the often heard disastrous consequences of a fatal mixture of caste, crime, family feuds and politics.\", 'languages': ['Hindi', 'Telugu', 'Tamil'], 'released': datetime.datetime(2010, 10, 22, 0, 0), 'directors': ['Ram Gopal Varma'], 'writers': ['Shyamraj Dutta (lyrics)', 'Sarim Momin (lyrics)', 'Prashant Pandey (story)', 'Sandeep Singh (lyrics)', 'Vayu (lyrics)'], 'awards': {'wins': 0, 'nominations': 4, 'text': '4 nominations.'}, 'lastupdated': '2015-08-20 00:43:42.733000000', 'year': 2010, 'imdb': {'rating': 7.6, 'votes': 2200, 'id': 1664809}, 'countries': ['India'], 'type': 'movie'}\n",
