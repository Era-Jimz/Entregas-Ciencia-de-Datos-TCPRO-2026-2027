            "{'_id': ObjectId('573a13dbf29313caabdaff21'), 'plot': \"The story of Steve Jobs' ascension from college dropout into one of the most revered creative entrepreneurs of the 20th century.\", 'genres': ['Biography', 'Drama'], 'runtime': 128, 'metacritic': 44, 'rated': 'PG-13', 'cast': ['Ashton Kutcher', 'Dermot Mulroney', 'Josh Gad', 'Lukas Haas'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTM5NTQ3MTYxN15BMl5BanBnXkFtZTcwODE2Nzk3OQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Jobs', 'fullplot': \"While living with his adoptive parents, Jobs is working for 'Atari'. He then, develops a partnership with his friend Steve Wozniak when he sees that Wozniak has built a personal computer (the Apple I). They name their new company 'Apple Computer' and start building Apple I computers. After many failed attempts by Jobs to gain venture capital, Mike Markkula invests in the company which allows them to move forward.\", 'languages': ['English'], 'released': datetime.datetime(2013, 8, 16, 0, 0), 'directors': ['Joshua Michael Stern'], 'writers': ['Matt Whiteley'], 'awards': {'wins': 0, 'nominations': 2, 'text': '2 nominations.'}, 'lastupdated': '2015-08-22 00:15:15.563000000', 'year': 2013, 'imdb': {'rating': 5.9, 'votes': 67184, 'id': 2357129}, 'countries': ['USA', 'Switzerland'], 'type': 'movie', 'tomatoes': {'website': 'http://thejobsmovie.com/', 'viewer': {'rating': 3.0, 'numReviews': 40350, 'meter': 40}, 'dvd': datetime.datetime(2013, 11, 26, 0, 0), 'critic': {'rating': 4.9, 'numReviews': 121, 'meter': 27}, 'boxOffice': '$16.1M', 'consensus': 'An ambitious but skin-deep portrait of an influential, complex figure, Jobs often has the feel of an over-sentimentalized made-for-TV biopic.', 'rotten': 88, 'production': 'Open Road Films', 'lastUpdated': datetime.datetime(2015, 9, 10, 17, 27, 44), 'fresh': 33}, 'num_mflix_comments': 0}\n",
