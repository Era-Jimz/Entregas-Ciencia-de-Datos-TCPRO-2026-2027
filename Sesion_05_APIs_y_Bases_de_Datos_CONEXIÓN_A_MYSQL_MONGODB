            "{'_id': ObjectId('573a13c9f29313caabd7a3f9'), 'plot': 'A father tries to help his son cope with a rare condition that causes the young boy to age beyond his years.', 'genres': ['Comedy', 'Drama'], 'runtime': 133, 'metacritic': 30, 'cast': ['Amitabh Bachchan', 'Abhishek Bachchan', 'Vidya Balan', 'Paresh Rawal'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BYWMwODliMDgtNzc5MS00NzZmLWJmYWEtMzU4Zjg3NzY3YzAyXkEyXkFqcGdeQXVyODE5NzE3OTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Paa', 'fullplot': \"Auro (Amitabh Bachchan) is an intelligent and witty 13-year-old boy with an extremely rare genetic defect that causes accelerated aging. He suffers from a progeria-like syndrome. Mentally he is 13, very normal, but physically he looks five times older. In spite of his condition, Auro is a very happy boy. He lives with his mother Vidya (Vidya Balan) who is a gynecologist. Amol Arte (Abhishek Bachchan) is young, progressive and a full-of-ideals politician. He is out to prove to the world that 'politics' is not a bad word. He is a man with a mission. Auro is Amol's son.\", 'languages': ['Hindi'], 'released': datetime.datetime(2009, 12, 4, 0, 0), 'directors': ['R. Balki'], 'writers': ['R. Balki'], 'awards': {'wins': 11, 'nominations': 10, 'text': '11 wins & 10 nominations.'}, 'lastupdated': '2015-09-12 00:36:40.220000000', 'year': 2009, 'imdb': {'rating': 7.2, 'votes': 6259, 'id': 1532957}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'website': 'http://www.paathefilm.com', 'viewer': {'rating': 3.6, 'numReviews': 1775, 'meter': 67}, 'dvd': datetime.datetime(2010, 1, 26, 0, 0), 'critic': {'rating': 5.9, 'numReviews': 5, 'meter': 60}, 'boxOffice': '$0.2M', 'rotten': 2, 'production': 'Big Pictures', 'lastUpdated': datetime.datetime(2015, 9, 1, 19, 8, 51), 'fresh': 3}}\n",
