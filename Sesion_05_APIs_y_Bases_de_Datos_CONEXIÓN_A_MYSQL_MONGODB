            "{'_id': ObjectId('573a13cbf29313caabd80575'), 'plot': 'John McClane travels to Russia to help out his seemingly wayward son, Jack, only to discover that Jack is a CIA operative working undercover, causing the father and son to team up against underworld forces.', 'genres': ['Action', 'Crime', 'Thriller'], 'runtime': 98, 'metacritic': 28, 'rated': 'R', 'cast': ['Bruce Willis', 'Jai Courtney', 'Sebastian Koch', 'Mary Elizabeth Winstead'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTcwNzgyNzUzOV5BMl5BanBnXkFtZTcwMzAwOTA5OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'A Good Day to Die Hard', 'fullplot': 'Iconoclastic, take-no-prisoners cop John McClane, for the first time, finds himself on foreign soil after traveling to Moscow to help his wayward son Jack - unaware that Jack is really a highly-trained CIA operative out to stop a nuclear weapons heist. With the Russian underworld in pursuit, and battling a countdown to war, the two McClanes discover that their opposing methods make them unstoppable heroes.', 'languages': ['English', 'Russian', 'Hindi'], 'released': datetime.datetime(2013, 2, 14, 0, 0), 'directors': ['John Moore'], 'writers': ['Skip Woods', 'Roderick Thorp (certain original characters by)'], 'awards': {'wins': 4, 'nominations': 6, 'text': '4 wins & 6 nominations.'}, 'lastupdated': '2015-09-05 00:33:22.887000000', 'year': 2013, 'imdb': {'rating': 5.3, 'votes': 153190, 'id': 1606378}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
