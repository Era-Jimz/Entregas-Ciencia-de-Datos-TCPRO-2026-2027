            "{'_id': ObjectId('573a13dff29313caabdb9781'), 'plot': \"American Vagabond is a cinematic feature documentary about gay youth living without a home in the shadows of a promised city. It's a story about a modern Western society in which ...\", 'genres': ['Documentary'], 'runtime': 85, 'cast': ['James Temple', 'Tyler Johnson', 'Sandy Temple', 'Jim Temple'], 'num_mflix_comments': 1, 'title': 'American Vagabond', 'fullplot': \"American Vagabond is a cinematic feature documentary about gay youth living without a home in the shadows of a promised city. It's a story about a modern Western society in which homosexuality is still so demonized in some communities that some parents are ready to abandon their children over it. One out of every four young people who are coming out to their parents is kicked out of the house. 20 to 40 percent of homeless youth are estimated to belong to sexual minorities in the United States.\", 'languages': ['English'], 'released': datetime.datetime(2013, 6, 26, 0, 0), 'directors': ['Susanna Helke'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-09-15 04:00:08.297000000', 'year': 2013, 'imdb': {'rating': 6.7, 'votes': 117, 'id': 2621714}, 'countries': ['Finland', 'Denmark'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.5, 'numReviews': 7}, 'website': 'http://www.americanvagabondfilm.com/', 'lastUpdated': datetime.datetime(2015, 5, 29, 20, 24, 22)}}\n",
