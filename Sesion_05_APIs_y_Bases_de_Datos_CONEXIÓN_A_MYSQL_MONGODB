            "{'_id': ObjectId('573a13caf29313caabd7e474'), 'plot': 'Two lovers travel from town to town playing a dark game of deceit that soon spirals out of control, threatening their very relationship.', 'genres': ['Drama'], 'runtime': 87, 'cast': ['Lee Tergesen', 'Enid Graham', 'Tate Ellington', 'Emily Meade'], 'poster': 'https://m.media-amazon.com/images/M/MV5BNzgxOTU0MTM4OF5BMl5BanBnXkFtZTcwNjI4MTU0NA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Silver Tongues', 'fullplot': 'SILVER TONGUES follows a couple, GERRY and JOAN, who use their talent for acting and performance as part of a dark game. Driving from town to town, the two lovers don different personas to deceive and destroy the lives of the people in their path. But each manipulation begins to take its toll. Soon the performances spiral out of control, and the game itself threatens their very relationship.', 'languages': ['English'], 'released': datetime.datetime(2011, 11, 18, 0, 0), 'directors': ['Simon Arthur'], 'writers': ['Simon Arthur'], 'awards': {'wins': 4, 'nominations': 1, 'text': '4 wins & 1 nomination.'}, 'lastupdated': '2015-08-19 00:36:22.110000000', 'year': 2011, 'imdb': {'rating': 6.6, 'votes': 650, 'id': 1580021}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13caf29313caabd7e4e4'), 'plot': \"ReGENERATION explores the inherent cynicism found in many of today's youth and young adults, and the influences that perpetuate our culture's apathetic approach to social and political ...\", 'genres': ['Documentary', 'Action', 'Biography'], 'runtime': 81, 'cast': ['Noam Chomsky', 'Ryan Gosling', 'Talib Kweli', 'Jay Walker'], 'poster': 'https://m.media-amazon.com/images/M/MV5BODY1NTYwOTIyN15BMl5BanBnXkFtZTgwNTkzNDA2MDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'ReGeneration', 'fullplot': \"ReGENERATION explores the inherent cynicism found in many of today's youth and young adults, and the influences that perpetuate our culture's apathetic approach to social and political causes. The film features three intersecting stories of students, parents, and artists all looking for their place in society. Together they capture the thoughts and feelings of today's struggling generation as some of the worlds leading scholars, activists, and media personalities provide their insight into the ideas and movements that can inspire change.\", 'languages': ['English'], 'released': datetime.datetime(2012, 5, 4, 0, 0), 'directors': ['Phillip Montgomery'], 'writers': ['Phillip Montgomery'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-12 00:12:50.987000000', 'year': 2010, 'imdb': {'rating': 6.9, 'votes': 189, 'id': 1580346}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
