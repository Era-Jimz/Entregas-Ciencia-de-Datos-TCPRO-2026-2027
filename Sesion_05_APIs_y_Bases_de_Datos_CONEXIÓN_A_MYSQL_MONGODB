            "{'_id': ObjectId('573a13f3f29313caabde067d'), 'plot': \"A small European town, where sisters Ayia and Mirra live, gets struck down by an unknown disease which takes many lives. Following their mother's death, the younger sister falls ill. Having...\", 'genres': ['Drama', 'Horror', 'Thriller'], 'runtime': 80, 'title': 'III', 'poster': 'https://m.media-amazon.com/images/M/MV5BMjM4NzE0MDAzN15BMl5BanBnXkFtZTgwMjk0MzYwNzE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['Germany', 'Russia'], 'fullplot': \"A small European town, where sisters Ayia and Mirra live, gets struck down by an unknown disease which takes many lives. Following their mother's death, the younger sister falls ill. Having realized that conventional medicine is useless in the face of the sister's disease, Ayia seeks help from Father Herman, a parish priest and a close family friend. In his house she finds books that are very far from the conventional religion. She gets to know that only penetration into Mirra's sick subconscious mind and discovery of the true cause of her disease will give her a chance to save her sister. Ayia is ready to go through this terrifying ritual, dive into the depths of the subconscious mind, and face the demons residing there.\", 'languages': ['Russian'], 'cast': ['Polina Davydova', 'Lyubov Ignatushko', 'Evgeniy Gagarin'], 'directors': ['Pavel Khvaleev'], 'writers': ['Aleksandra Khvaleeva (story)', 'Aleksandra Khvaleeva', 'Aleksandra Khvaleeva', 'Oleg Mustafin (story)', 'Evgeniya Mustafina (story)'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-20 00:58:42.127000000', 'year': 2015, 'imdb': {'rating': 6.7, 'votes': 249, 'id': 3993732}, 'type': 'movie', 'num_mflix_comments': 0}\n",
