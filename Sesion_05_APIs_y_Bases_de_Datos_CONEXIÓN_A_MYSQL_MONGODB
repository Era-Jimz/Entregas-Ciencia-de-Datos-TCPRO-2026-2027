            "{'_id': ObjectId('573a13e9f29313caabdcd391'), 'plot': 'Carrie Watts begrudgingly lives with her busy, overprotective son, Ludie, and pretentious daughter-in-law, Jessie Mae. No longer able to drive and forbidden to travel alone, she wishes for ...', 'genres': ['Drama'], 'countries': ['USA'], 'cast': ['Cicely Tyson', 'Vanessa Williams', 'Blair Underwood', 'Keke Palmer'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTkwODI5MDQyOF5BMl5BanBnXkFtZTgwMzM4NTYxMTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Trip to Bountiful', 'fullplot': 'Carrie Watts begrudgingly lives with her busy, overprotective son, Ludie, and pretentious daughter-in-law, Jessie Mae. No longer able to drive and forbidden to travel alone, she wishes for freedom from the confines of the house and begs her son to take her on a visit to her hometown of Bountiful. When he refuses, Mrs. Watts is undeterred and makes an escape to the local bus station, where she befriends Thelma, a young woman traveling home. When Ludie and Jessie Mae discover she is gone, they call in law enforcement to help, but Mrs. Watts is one step ahead of them and convinces the local sheriff to help her on her journey home to Bountiful.', 'languages': ['English'], 'released': datetime.datetime(2014, 3, 8, 0, 0), 'directors': ['Michael Wilson'], 'writers': ['Horton Foote (based on his play)', 'Horton Foote (teleplay)'], 'awards': {'wins': 10, 'nominations': 14, 'text': 'Nominated for 2 Primetime Emmys. Another 8 wins & 14 nominations.'}, 'lastupdated': '2015-08-14 01:12:16.067000000', 'year': 2014, 'imdb': {'rating': 7.0, 'votes': 373, 'id': 3317326}, 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13e9f29313caabdccb91'), 'plot': 'One Last Hug: Three Days at Grief Camp chronicles a three day summer camp for children learning to cope with the death of a loved one. With the guidance of trained professionals, grieving ...', 'genres': ['Documentary', 'Short', 'Family'], 'runtime': 37, 'title': 'One Last Hug: Three Days at Grief Camp', 'poster': 'https://m.media-amazon.com/images/M/MV5BMTcyMjQ4NTg2MF5BMl5BanBnXkFtZTgwMzE1MTI5NDE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['USA'], 'fullplot': \"One Last Hug: Three Days at Grief Camp chronicles a three day summer camp for children learning to cope with the death of a loved one. With the guidance of trained professionals, grieving children as young as seven years old learn that their feelings are normal, and that by talking about them they can begin to heal. A testament to the healing power of shared sorrow, One Last Hug shows the often-unseen and particular experience of children's grief.\", 'languages': ['English'], 'released': datetime.datetime(2014, 4, 14, 0, 0), 'directors': ['Irene Taylor Brodsky'], 'rated': 'TV-PG', 'awards': {'wins': 2, 'nominations': 0, 'text': 'Won 1 Primetime Emmy. Another 1 win.'}, 'lastupdated': '2015-06-27 00:39:31.387000000', 'year': 2014, 'imdb': {'rating': 7.6, 'votes': 69, 'id': 3300942}, 'type': 'movie', 'num_mflix_comments': 0}\n",
