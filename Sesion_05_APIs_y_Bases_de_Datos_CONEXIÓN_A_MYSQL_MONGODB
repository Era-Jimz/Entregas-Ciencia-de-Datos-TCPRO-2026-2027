            "{'_id': ObjectId('573a13e8f29313caabdc92fd'), 'plot': 'A recently cheated on married woman falls for a younger man who has moved in next door, but their torrid affair soon takes a dangerous turn.', 'genres': ['Mystery', 'Thriller'], 'runtime': 91, 'metacritic': 30, 'rated': 'R', 'cast': ['Jennifer Lopez', 'Ryan Guzman', 'Ian Nelson', 'John Corbett'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTgxNTEyMTYzOV5BMl5BanBnXkFtZTgwNzQ4OTg5MjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Boy Next Door', 'fullplot': \"When a handsome, charming teenager named Noah (Ryan Guzman) moves in next door, newly separated high-school teacher Claire Peterson (Jennifer Lopez) encourages his friendship and engages in a little bit of harmless (or so she thinks) flirtation. Although Noah spends much of the time hanging out with Claire's son, the teen's attraction to her is palpable. One night, Claire gives in to temptation and lets Noah seduce her, but when she tries to end the relationship, he turns violent.\", 'languages': ['English'], 'released': datetime.datetime(2015, 1, 23, 0, 0), 'directors': ['Rob Cohen'], 'writers': ['Barbara Curry'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-08-18 00:03:37.283000000', 'year': 2015, 'imdb': {'rating': 4.6, 'votes': 19280, 'id': 3181822}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
