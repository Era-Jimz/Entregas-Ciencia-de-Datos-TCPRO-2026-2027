            "{'_id': ObjectId('573a13dcf29313caabdb13bb'), 'plot': 'The torrid relationship between Elizabeth Taylor and Richard Burton.', 'genres': ['Biography', 'Drama'], 'runtime': 88, 'cast': ['Lindsay Lohan', 'Grant Bowler', 'Theresa Russell', 'David Hunt'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY2ODQwMTgwNV5BMl5BanBnXkFtZTcwNjkwOTk0OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Liz & Dick', 'fullplot': \"On the set of Cleopatra, Hollywood's most beautiful star, Elizabeth Taylor, fell into the arms of one of the world's greatest actors, Richard Burton - and she didn't leave. Their subsequent white-hot, scandalous love affair gave rise to the paparazzi and they became the most hunted and photographed couple on earth. Their rocky, passionate, relationship, born in front of the cameras, was subsequently captured in a series of films, including The V.I.P.s and Who's Afraid of Virginia Woolf? The last of the great, extravagant stars, flaunting diamonds, yachts and private planes, they continually seized the headlines. They even divorced and married again - only to divorce again - but remain in each other's hearts. This Elizabeth Taylor - Richard Burton story is a no-holds barred account of their undying, but impossible love.\", 'languages': ['English'], 'released': datetime.datetime(2012, 11, 25, 0, 0), 'directors': ['Lloyd Kramer'], 'writers': ['Christopher Monger'], 'awards': {'wins': 3, 'nominations': 0, 'text': 'Nominated for 2 Primetime Emmys. Another 1 win.'}, 'lastupdated': '2015-09-13 00:04:14.187000000', 'year': 2012, 'imdb': {'rating': 4.0, 'votes': 3424, 'id': 2375255}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 2.2, 'numReviews': 443, 'meter': 20}, 'dvd': datetime.datetime(2013, 5, 14, 0, 0), 'critic': {'rating': 2.8, 'numReviews': 6, 'meter': 33}, 'lastUpdated': datetime.datetime(2015, 9, 2, 18, 34, 46), 'rotten': 4, 'production': 'E1 Entertainment', 'fresh': 2}, 'num_mflix_comments': 0}\n",
