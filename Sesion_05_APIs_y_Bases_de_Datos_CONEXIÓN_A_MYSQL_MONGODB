            "{'_id': ObjectId('573a13e0f29313caabdba62f'), 'plot': 'A junior barrister specializes in spiriting people out of tight legal corners.', 'genres': ['Drama', 'Thriller'], 'runtime': 180, 'title': 'The Escape Artist', 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY2MGEzNmItOGRjOC00Njk1LWJjYjctMGUwOGIwNzk3NzBkXkEyXkFqcGdeQXVyMTk3NDAwMzI@._V1_SY1000_SX677_AL_.jpg', 'countries': ['UK'], 'fullplot': 'Revolves around Will Burton, a talented junior barrister of peerless intellect and winning charm who specialises in spiriting people out of tight legal corners. He is in high demand as he has never lost a case. But when his talents acquit the notorious prime suspect in an horrific murder trial, that brilliance comes back to bite him with unexpected and chilling results, not to mention a shocking twist in the tale.', 'languages': ['English'], 'cast': ['David Tennant', 'Toby Kebbell', 'Gus Barry', 'Brid Brennan'], 'awards': {'wins': 1, 'nominations': 2, 'text': '1 win & 2 nominations.'}, 'lastupdated': '2015-08-25 00:20:20.400000000', 'year': 2013, 'imdb': {'rating': 7.7, 'votes': 3041, 'id': 2649522}, 'type': 'series', 'tomatoes': {'viewer': {'rating': 3.3, 'numReviews': 312}, 'production': 'Warner Bros. Pictures', 'lastUpdated': datetime.datetime(2015, 9, 2, 18, 54, 15)}}\n",
