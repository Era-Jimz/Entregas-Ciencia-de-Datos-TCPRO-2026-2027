            "{'_id': ObjectId('573a13d6f29313caabda034c'), 'plot': 'Of Two Minds explores the extraordinary lives, struggles and successes of three unique and compelling people living with bipolar disorder in America today. Through a combination of intimate...', 'genres': ['Documentary', 'Biography', 'Drama'], 'runtime': 89, 'title': 'Of Two Minds', 'poster': 'https://m.media-amazon.com/images/M/MV5BMjA2NTQ5NDYyOF5BMl5BanBnXkFtZTgwNDEzNjA2MDE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['USA', 'France', 'Canada'], 'fullplot': \"Of Two Minds explores the extraordinary lives, struggles and successes of three unique and compelling people living with bipolar disorder in America today. Through a combination of intimate veritè and revealing interviews, we experience what it feels like to be bipolar - from exquisite feelings of grandiosity and sensuality to the depths of despair and depression. A journey from the painful to the painfully funny, Of Two Minds puts a human face on the illness, opening an engaging, harrowing and perception-changing view on those all around us who live in bipolar's shadows...our sisters and brothers, parents and friends, and ourselves.\", 'languages': ['English'], 'cast': ['Terri Cheney', 'Carlton Davis', 'Cheri Keating', 'Jenifer Lewis'], 'directors': ['Douglas Blush', 'Lisa J. Klein'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-12 00:37:22.430000000', 'year': 2012, 'imdb': {'rating': 6.8, 'votes': 180, 'id': 2090582}, 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.4, 'numReviews': 104, 'meter': 51}, 'dvd': datetime.datetime(2012, 11, 13, 0, 0), 'website': 'http://www.oftwomindsmovie.com', 'production': 'Sony Pictures Entertainment', 'lastUpdated': datetime.datetime(2015, 9, 15, 17, 7, 41)}, 'num_mflix_comments': 0}\n",
