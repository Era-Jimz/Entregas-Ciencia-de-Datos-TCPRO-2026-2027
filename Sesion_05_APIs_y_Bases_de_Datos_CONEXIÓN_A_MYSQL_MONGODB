            "{'_id': ObjectId('573a13e6f29313caabdc570e'), 'plot': 'The New Black is a documentary that tells the story of how the African-American community is grappling with the gay rights issue in light of the recent gay marriage movement and the fight ...', 'genres': ['Documentary', 'Drama', 'News'], 'runtime': 80, 'metacritic': 68, 'title': 'The New Black', 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjA4NzY1MzYwOV5BMl5BanBnXkFtZTgwNjE3MTk4NTE@._V1_SY1000_SX677_AL_.jpg', 'countries': ['USA'], 'fullplot': \"The New Black is a documentary that tells the story of how the African-American community is grappling with the gay rights issue in light of the recent gay marriage movement and the fight over civil rights. The film documents activists, families and clergy on both sides of the campaign to legalize gay marriage and examines homophobia in the black community's institutional pillar-the black church and reveals the Christian right wing's strategy of exploiting this phenomenon in order to pursue an anti-gay political agenda. The New Black takes viewers into the pews and onto the streets and provides a seat at the kitchen table as it tells the story of the historic fight to win marriage equality in Maryland and charts the evolution of this divisive issue within the black community.\", 'languages': ['English'], 'released': datetime.datetime(2013, 6, 14, 0, 0), 'directors': ['Yoruba Richen'], 'writers': ['Erin Casper', 'Yoruba Richen'], 'awards': {'wins': 3, 'nominations': 2, 'text': '3 wins & 2 nominations.'}, 'lastupdated': '2015-09-04 00:31:57.397000000', 'year': 2013, 'imdb': {'rating': 6.4, 'votes': 48, 'id': 3060670}, 'type': 'movie', 'tomatoes': {'website': 'http://www.newblackfilm.com/', 'viewer': {'rating': 4.1, 'numReviews': 130, 'meter': 73}, 'critic': {'rating': 7.0, 'numReviews': 13, 'meter': 85}, 'lastUpdated': datetime.datetime(2015, 9, 3, 18, 45, 17), 'rotten': 2, 'production': 'Promised Land Film, Inc.', 'fresh': 11}}\