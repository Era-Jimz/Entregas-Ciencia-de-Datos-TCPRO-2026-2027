            "{'_id': ObjectId('573a13f2f29313caabdddc8c'), 'plot': \"Jack is a fifteen year-old delinquent stuck in a run-down small town. Trapped in a violent feud with a cruel older bully and facing another bout of summer school, Jack's got all the ...\", 'genres': ['Adventure'], 'countries': ['USA'], 'cast': ['Charlie Plummer', 'Cory Nichols', 'Christian Madsen', 'Danny Flaherty'], 'num_mflix_comments': 0, 'title': 'King Jack', 'fullplot': \"Jack is a fifteen year-old delinquent stuck in a run-down small town. Trapped in a violent feud with a cruel older bully and facing another bout of summer school, Jack's got all the problems he can handle. So when Jack's aunt falls ill and his runty younger cousin must stay with him for the weekend the last thing Jack wants to do is look after him. Unfortunately no one really cares what Jack wants. Set over a hazy summer weekend, King Jack is a tough and tender coming of age story about friendship and finding happiness in bleak surroundings.\", 'languages': ['English'], 'released': datetime.datetime(2015, 4, 17, 0, 0), 'directors': ['Felix Thompson'], 'writers': ['Felix Thompson'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-07-26 00:22:54.273000000', 'year': 2015, 'imdb': {'rating': 8.2, 'votes': 34, 'id': 3863484}, 'type': 'movie'}\n",
