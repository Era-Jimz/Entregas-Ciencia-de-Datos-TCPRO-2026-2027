            "{'_id': ObjectId('573a13e1f29313caabdbd50d'), 'plot': 'Five university friends gather at a house party to ring in the New Year. Unbeknownst to them, an epidemic has erupted outside, causing outbreaks around the world.', 'genres': ['Horror', 'Sci-Fi', 'Thriller'], 'runtime': 90, 'cast': ['Michelle Mylett', 'Cody Ray Thompson', 'Adam Christie', 'Ana Alic'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTgyMTYyNTYwNF5BMl5BanBnXkFtZTgwNTQ1Nzk2MDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Antisocial', 'fullplot': 'Five university friends gather at a house party to ring in the New Year. Unbeknownst to them, an epidemic has erupted outside, causing outbreaks around the world. With nowhere else to turn, they barricade themselves indoors with only their phones, laptops, and other tech devices. They use their devices to research the possible cause of this outbreak. Information and video footage over flow their computers as they descend further into the cause and the ensuing chaos. As the virus spreads, the mood in the house changes from fear to paranoia. Who is safe? Who can they trust? Reality becomes blurred as they slowly discover the source of the virus causing the sickness...and there is no going back.', 'languages': ['English'], 'released': datetime.datetime(2014, 1, 28, 0, 0), 'directors': ['Cody Calahan'], 'writers': ['Chad Archibald', 'Cody Calahan'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-19 00:30:27.017000000', 'year': 2013, 'imdb': {'rating': 4.5, 'votes': 1871, 'id': 2772092}, 'countries': ['Canada'], 'type': 'movie', 'tomatoes': {'website': 'http://www.facebook.com/AntisocialTheMovie', 'viewer': {'rating': 2.2, 'numReviews': 180, 'meter': 17}, 'dvd': datetime.datetime(2014, 1, 27, 0, 0), 'critic': {'rating': 3.8, 'numReviews': 5, 'meter': 0}, 'lastUpdated': datetime.datetime(2015, 8, 18, 18, 42, 44), 'rotten': 5, 'production': 'Breaking Glass Pictures', 'fresh': 0}, 'num_mflix_comments': 0}\n",
