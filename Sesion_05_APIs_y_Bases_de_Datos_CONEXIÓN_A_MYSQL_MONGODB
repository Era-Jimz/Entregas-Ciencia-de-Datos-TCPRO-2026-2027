            "{'_id': ObjectId('573a13dff29313caabdb75bd'), 'plot': 'Ghadi is different from other kids; could he be an angel? His father Leba, along with his teammates, tricks the town into believing so.', 'genres': ['Comedy', 'Drama', 'Family'], 'runtime': 100, 'cast': ['Georges Khabbaz', 'Lara Rain', 'Emmanuel Khairallah', 'Camille Salameh'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjE3MjU4MzU2OF5BMl5BanBnXkFtZTgwNTEyNTY2MTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Ghadi', 'fullplot': \"In a small neighborhood of a traditional Lebanese coastal town, Leba (Georges Khabbaz), a music instructor, marries his childhood sweetheart Lara. To the dismay of his family, neighbors, and friends, he has a first baby girl and then a second one. Lara is pregnant for the third time, and yes, it's a BOY! However, medical tests show that the boy will have special needs. Will Leba and Lara keep the baby? Will little Ghadi become a burden on the family, or will he be its pride and joy? Expect strange phenomena to affect the behavior and beliefs of that little town's population.\", 'languages': ['Arabic'], 'released': datetime.datetime(2013, 10, 31, 0, 0), 'directors': ['Amin Dora'], 'writers': ['Georges Khabbaz'], 'awards': {'wins': 3, 'nominations': 2, 'text': '3 wins & 2 nominations.'}, 'lastupdated': '2015-08-31 00:11:34.123000000', 'year': 2013, 'imdb': {'rating': 7.6, 'votes': 393, 'id': 2552296}, 'countries': ['Lebanon'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.1, 'numReviews': 11}, 'website': 'http://www.ghadithemovie.com/', 'lastUpdated': datetime.datetime(2015, 6, 20, 18, 5, 51)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13dff29313caabdb7955'), 'plot': 'A 35-year-old woman fakes being pregnant to fit in with her friends.', 'genres': ['Comedy', 'Drama'], 'runtime': 109, 'metacritic': 45, 'cast': ['Sonja Bennett', 'James Caan', 'Danny Trejo', 'Paul Campbell'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQ1OTQxMzM4M15BMl5BanBnXkFtZTgwNDgxMjA2NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Preggoland', 'fullplot': 'Preggoland tells the story of Ruth, a 35-year-old woman who pretends to be pregnant to fit in with her friends. Although Ruth initially tries to come clean, the perks of pregnancy are too seductive to ignore and she soon finds herself living a lie. Starring Sonja Bennett (who also wrote the script), James Caan and Danny Trejo and directed by Jacob Tierney (The Trotsky), Preggoland is a comedy that looks at the lengths we will go just to feel special.', 'languages': ['English'], 'released': datetime.datetime(2015, 5, 8, 0, 0), 'directors': ['Jacob Tierney'], 'writers': ['Sonja Bennett', 'Sonja Bennett'], 'awards': {'wins': 3, 'nominations': 9, 'text': '3 wins & 9 nominations.'}, 'lastupdated': '2015-08-26 00:35:10.697000000', 'year': 2014, 'imdb': {'rating': 5.5, 'votes': 322, 'id': 2559458}, 'countries': ['Canada'], 'type': 'movie', 'tomatoes': {'website': 'http://www.mongrelmedia.com/film/preggoland.aspx', 'viewer': {'rating': 3.2, 'numReviews': 182, 'meter': 54}, 'dvd': datetime.datetime(2015, 8, 11, 0, 0), 'critic': {'rating': 5.1, 'numReviews': 17, 'meter': 41}, 'lastUpdated': datetime.datetime(2015, 9, 11, 17, 1, 41), 'rotten': 10, 'production': 'Gravitas Ventures', 'fresh': 7}}\n",
            "{'_id': ObjectId('573a13dff29313caabdb7c43'), 'plot': 'Journalist Shuichi Fujii receives a letter from convicted killer Junji Sudo. Writing from death row, Sudo wants to confess to crimes unknown to the police. On visiting Sudo in prison, Fujii...', 'genres': ['Thriller'], 'runtime': 128, 'cast': ['Takayuki Yamada', 'Pierre Taki', 'Rirè Furankè', 'Chizuru Ikewaki'], 'num_mflix_comments': 1, 'title': \"The Devil's Path\", 'fullplot': 'Journalist Shuichi Fujii receives a letter from convicted killer Junji Sudo. Writing from death row, Sudo wants to confess to crimes unknown to the police. On visiting Sudo in prison, Fujii learns about a real estate broker called \"Doc\" who masterminded a string of murders that Sudo worked muscle for. Set up by Doc, Sudo seeks revenge and implores Fujii to find the evidence needed to bring in his former boss. Working off Sudo\\'s sketchy memories, Fujii begins to piece together a grizzly tale of extortion, torture, rape, and arson. But as his desire to see Doc brought to justice nears the boiling point, he runs into resistance from his editor, who views the story as tripe, the police, who seem indifferent to the case, and his wife, who is at her wits\\' end dealing with his mother\\'s increasing dementia. Based on true crime cases, \"The Devil\\'s Path\" exposes the secret underbelly of crime in modern Japan.', 'languages': ['Japanese'], 'released': datetime.datetime(2013, 9, 21, 0, 0), 'directors': ['Kazuya Shiraishi'], 'writers': ['Kazuya Shiraishi (screenplay)', 'Izumi Takahashi (screenplay)'], 'awards': {'wins': 10, 'nominations': 8, 'text': '10 wins & 8 nominations.'}, 'lastupdated': '2015-08-23 00:59:05.530000000', 'year': 2013, 'imdb': {'rating': 7.2, 'votes': 274, 'id': 2565752}, 'countries': ['Japan'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.4, 'numReviews': 20}, 'lastUpdated': datetime.datetime(2015, 9, 3, 18, 54, 53)}}\n",
