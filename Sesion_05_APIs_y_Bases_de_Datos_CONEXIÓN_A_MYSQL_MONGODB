            "{'_id': ObjectId('573a13d6f29313caabd9f9e3'), 'plot': \"Internationally acclaimed ventriloquist Nina Conti, takes the bereaved puppets of her mentor and erstwhile lover Ken Campbell on a pilgrimage to 'Venthaven' the resting place for puppets of...\", 'genres': ['Documentary', 'Biography', 'Comedy'], 'runtime': 64, 'cast': ['Nina Conti', 'Jim Broadbent', 'Daisy Campbell', 'Ken Campbell'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTcxMDk5NTU2NF5BMl5BanBnXkFtZTcwNDUzNzczOQ@@._V1_SY1000_SX677_AL_.jpg', 'title': \"Her Master's Voice\", 'fullplot': \"Internationally acclaimed ventriloquist Nina Conti, takes the bereaved puppets of her mentor and erstwhile lover Ken Campbell on a pilgrimage to 'Venthaven' the resting place for puppets of dead ventriloquists. She gets to know her latex and wooden travelling partners along the way, and with them deconstructs herself and her lost love in this ventriloquial docu-mocumentary requiem. Ken Campbell was a hugely respected maverick of the British Theatre, an eccentric genius who would snort out forgotten artforms. Nina was his prodigy in ventriloquism and has been said to have reinvented the artform. This film is truly unique in genre and style. No one has seen ventriloquism like this before.\", 'languages': ['English'], 'released': datetime.datetime(2014, 2, 6, 0, 0), 'directors': ['Nina Conti'], 'writers': ['Nina Conti'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-08-16 01:15:00.370000000', 'year': 2012, 'imdb': {'rating': 7.5, 'votes': 242, 'id': 2081260}, 'countries': ['UK', 'USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.0, 'numReviews': 64, 'meter': 76}, 'dvd': datetime.datetime(2012, 9, 25, 0, 0), 'production': 'Virgil Films', 'lastUpdated': datetime.datetime(2015, 9, 16, 20, 50, 13)}}\n",
