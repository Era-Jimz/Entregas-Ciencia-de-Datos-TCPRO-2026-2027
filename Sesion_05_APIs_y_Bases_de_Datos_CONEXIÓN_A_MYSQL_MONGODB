            "{'_id': ObjectId('573a13dbf29313caabdb0235'), 'plot': 'The life story of basketball sensation, Jeremy Lin.', 'genres': ['Documentary', 'Biography', 'Sport'], 'runtime': 89, 'metacritic': 52, 'rated': 'PG', 'cast': ['Daniel Dae Kim', 'Jeremy Lin', 'Ming Yao', 'Landry Fields'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjAxNzU4ODM3Nl5BMl5BanBnXkFtZTgwNTIwMTEyMDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Linsanity', 'fullplot': \"In February 2012, an entire nation of basketball fans unexpectedly went 'Linsane.' Stuck in the mire of a disappointing season, the New York Knicks did what no other NBA team had thought about doing. They gave backup point guard Jeremy Lin an opportunity to prove himself. He took full advantage, scoring more points in his first five NBA starts than any other player in the modern era, and created a legitimate public frenzy in the process. Prior to this now-legendary run, Lin had faced adversity in his career at every turn. He wasn't offered a scholarship by any major university, nor was he drafted by any NBA team after a standout collegiate career at Harvard.\", 'languages': ['English', 'Mandarin'], 'released': datetime.datetime(2013, 10, 2, 0, 0), 'directors': ['Evan Leong'], 'writers': ['Aaron Strongoni (narration writer)'], 'awards': {'wins': 2, 'nominations': 1, 'text': '2 wins & 1 nomination.'}, 'lastupdated': '2015-09-06 00:03:59.527000000', 'year': 2013, 'imdb': {'rating': 7.4, 'votes': 1554, 'id': 2359427}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.linsanitythemovie.com', 'viewer': {'rating': 4.0, 'numReviews': 667, 'meter': 77}, 'dvd': datetime.datetime(2014, 1, 6, 0, 0), 'critic': {'rating': 5.4, 'numReviews': 24, 'meter': 63}, 'boxOffice': '$0.3M', 'rotten': 9, 'production': 'Ketchup Entertainment', 'lastUpdated': datetime.datetime(2015, 9, 11, 17, 55, 58), 'fresh': 15}, 'num_mflix_comments': 0}\n",
