            "{'_id': ObjectId('573a13dcf29313caabdb273d'), 'plot': 'A council case worker looks for the relatives of those found dead and alone.', 'genres': ['Comedy', 'Drama'], 'runtime': 92, 'metacritic': 45, 'cast': ['Eddie Marsan', 'Joanne Froggatt', 'Karen Drury', 'Andrew Buchan'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjIyMzI1ODU5MF5BMl5BanBnXkFtZTgwNTIyMTI2MzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Still Life', 'fullplot': 'Still Life is a poignant, quixotic tale of life, love and the afterlife. Meticulous and organized to the point of obsession, John May (Eddie Marsan) is a council worker charged with finding the next of kin of those who have died alone. When his department is downsized, John must up his efforts on his final case, taking him on a liberating journey that allows him to start living life at last.', 'languages': ['English'], 'released': datetime.datetime(2013, 12, 12, 0, 0), 'directors': ['Uberto Pasolini'], 'writers': ['Uberto Pasolini'], 'awards': {'wins': 17, 'nominations': 4, 'text': '17 wins & 4 nominations.'}, 'lastupdated': '2015-09-15 05:38:38.433000000', 'year': 2013, 'imdb': {'rating': 7.4, 'votes': 3401, 'id': 2395417}, 'countries': ['UK', 'Italy'], 'type': 'movie', 'tomatoes': {'website': 'http://tribecafilm.com/tribecafilm/filmguide/still-life', 'viewer': {'rating': 3.7, 'numReviews': 1663, 'meter': 75}, 'critic': {'rating': 6.2, 'numReviews': 40, 'meter': 63}, 'lastUpdated': datetime.datetime(2015, 9, 1, 18, 19, 53), 'consensus': 'Still Life moves with a quiet grace that some viewers may mistake for mannered passivity, but rewards patience with genuine poignancy.', 'rotten': 15, 'production': 'Tribeca Film', 'fresh': 25}, 'num_mflix_comments': 0}\n",
