            "{'_id': ObjectId('573a13dcf29313caabdb2198'), 'plot': \"Filmmaker David Sieveking portays the home care of his mother who, like 2 million other people in Germany, suffers from Alzheimer's Disease. David's parents had been a part of the student ...\", 'genres': ['Documentary', 'Biography', 'Family'], 'runtime': 88, 'cast': ['Margarete Sieveking', 'Malte Sieveking', 'David Sieveking'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg5MzA3MDA4OF5BMl5BanBnXkFtZTgwMDYxMjg3MTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Vergiss mein nicht', 'fullplot': \"Filmmaker David Sieveking portays the home care of his mother who, like 2 million other people in Germany, suffers from Alzheimer's Disease. David's parents had been a part of the student movement in the sixties and led an open relationship, which is now put to the test dramatically by the disease. The whole family has to deal with the smoldering conflicts to find a new solidarity.\", 'languages': ['German'], 'released': datetime.datetime(2013, 1, 31, 0, 0), 'directors': ['David Sieveking'], 'writers': ['David Sieveking'], 'awards': {'wins': 1, 'nominations': 2, 'text': '1 win & 2 nominations.'}, 'lastupdated': '2015-05-13 00:38:32.320000000', 'year': 2012, 'imdb': {'rating': 7.6, 'votes': 222, 'id': 2389530}, 'countries': ['Germany'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.2, 'numReviews': 7, 'meter': 100}, 'dvd': datetime.datetime(2014, 5, 26, 0, 0), 'lastUpdated': datetime.datetime(2015, 6, 14, 19, 3, 19)}}\n",
            "{'_id': ObjectId('573a13dcf29313caabdb22cb'), 'plot': 'The coming-of-age story about a Canadian First Nations girl who triumphs over obstacles in her young life. Her new teacher discovers her extraordinary gifts as a violinist. When Shana goes ...', 'genres': ['Drama', 'Family'], 'runtime': 96, 'cast': ['Alana Aspinall', 'Marty Aspinall', 'Delilah Dick', 'Vonnet Hall'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjEyMTczNDk4NV5BMl5BanBnXkFtZTgwMTMyNTY5MzE@._V1_SY1000_SX677_AL_.jpg', 'title': \"Shana: The Wolf's Music\", 'fullplot': \"The coming-of-age story about a Canadian First Nations girl who triumphs over obstacles in her young life. Her new teacher discovers her extraordinary gifts as a violinist. When Shana goes on a spiritual journey, she befriends a wild wolf who guides her and she reconnects with her ancestors, including her mother. Finally, she is able to make peace with her mother's death and, absorbed by nature and the spiritual world, Shana finds a unique way of musical expression, which will allow her to have a career as a violinist. Filmed with the People of the Creeks, the Lower Nicola Indian Band near Merritt, BC. The entire cast is local and first time film performers. The Swiss director Nino Jacusso who spent seven months with them calls them 'real actors' as they are the real people. A moving, magical, and yet authentic inter-cultural motion picture.\", 'languages': ['English'], 'released': datetime.datetime(2015, 4, 23, 0, 0), 'directors': ['Nino Jacusso'], 'writers': ['Nino Jacusso'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-06 00:23:03.010000000', 'year': 2014, 'imdb': {'rating': 5.8, 'votes': 45, 'id': 2390792}, 'countries': ['Canada', 'Switzerland'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.0, 'numReviews': 1}, 'lastUpdated': datetime.datetime(2015, 7, 3, 18, 14, 1)}}\n",
