            "{'_id': ObjectId('573a13dff29313caabdb77c1'), 'plot': 'A military officer attempts to hunt down a terrorist, destroy a terrorist gang and deactivate the sleeper cells under its command.', 'genres': ['Action', 'Drama', 'Mystery'], 'runtime': 170, 'cast': ['Akshay Kumar', 'Sonakshi Sinha', 'Freddy Daruwala', 'Sumeet Raghvan'], 'num_mflix_comments': 0, 'title': 'Holiday', 'fullplot': 'Virat (Akshay Kumar) is among a battalion of military officers that comes to Mumbai on vacation. Virat is also a secret Defence Intelligence Agent who cannot lie low, much to the irritation of his friend and sub inspector. During a bus ride, an attempt to frisk passengers for a lost wallet leads Virat to something much bigger. Within minutes, the bus is blown into pieces and he helps cops nab the carrier of the bomb, who escapes from the hospital only to be caught by Virat again. Using tact, Virat follows one clue at a time hoping to track down the terrorist on whose orders the sleeper cell terrorists plan to cause mayhem in Mumbai.', 'languages': ['Hindi'], 'released': datetime.datetime(2014, 6, 6, 0, 0), 'directors': ['A.R. Murugadoss'], 'writers': ['A.R. Murugadoss'], 'awards': {'wins': 1, 'nominations': 6, 'text': '1 win & 6 nominations.'}, 'lastupdated': '2015-09-13 00:01:48.333000000', 'year': 2014, 'imdb': {'rating': 7.4, 'votes': 9978, 'id': 2556308}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.6, 'numReviews': 793, 'meter': 65}, 'website': 'http://feriadofilm.com/', 'production': 'Reliance Entertainment', 'boxOffice': '$0.7M', 'lastUpdated': datetime.datetime(2015, 9, 3, 18, 3, 46)}}\n",
