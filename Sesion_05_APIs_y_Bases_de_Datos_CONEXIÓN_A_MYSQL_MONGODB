            "{'_id': ObjectId('573a13d5f29313caabd9a34c'), 'plot': 'Dramatization of the bitter blood feud between the two families on the West Virginia/Kentucky border in the years after the Civil War.', 'genres': ['Drama', 'History', 'Romance'], 'runtime': 290, 'cast': ['Kevin Costner', 'Bill Paxton', 'Matt Barr', 'Tom Berenger'], 'poster': 'https://m.media-amazon.com/images/M/MV5BNDIyNDUzNzQ0Ml5BMl5BanBnXkFtZTcwNzc5Nzg3Nw@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Hatfields & McCoys', 'fullplot': \"A clash of clans that evoked great passion, vengeance, courage, sacrifice, crimes and accusations, which changed the families and the history of the region forever. The Hatfield-McCoy saga begins with 'Devil' Anse Hatfield and Randall McCoy. Close friends and comrades until near the end of the Civil War, they return to their neighboring homes - Hatfield in West Virginia, McCoy just across the Tug River border in Kentucky - to increasing tensions, misunderstandings and resentments that soon explode into all-out warfare between the families. As hostilities grow, friends, neighbors and outside forces join the fight, bringing the two states to the brink of another Civil War.\", 'languages': ['English'], 'released': datetime.datetime(2012, 5, 28, 0, 0), 'rated': 'TV-14', 'awards': {'wins': 15, 'nominations': 40, 'text': 'Won 1 Golden Globe. Another 14 wins & 40 nominations.'}, 'lastupdated': '2015-09-16 11:04:53.040000000', 'year': 2012, 'imdb': {'rating': 8.1, 'votes': 16395, 'id': 1985443}, 'countries': ['USA'], 'type': 'series', 'tomatoes': {'viewer': {'numReviews': 326, 'meter': 94}, 'fresh': 2, 'critic': {'numReviews': 2}, 'rotten': 0, 'lastUpdated': datetime.datetime(2013, 2, 18, 0, 0)}, 'num_mflix_comments': 0}\n",
