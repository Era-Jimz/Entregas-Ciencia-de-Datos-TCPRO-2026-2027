            "{'_id': ObjectId('573a13caf29313caabd7d650'), 'plot': 'An ensemble film about four everyday people: a store manager, a security guard, a fire fighter and a clerk who struggle in the aftermath of trauma.', 'genres': ['Comedy', 'Drama'], 'runtime': 118, 'cast': ['Karine Vanasse', 'Cory Monteith', 'Emily Hampshire', 'Kevin Zegers'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY0MDUyMTg1N15BMl5BanBnXkFtZTgwMDI1NTE1MDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'All the Wrong Reasons', 'fullplot': \"All the Wrong Reasons is an ensemble film about four co-workers at a big box department store. Since witnessing a tragic family event, Kate has kept herself as isolated as physically possible, even at work. Her husband James, the store's ambitious manager, does his best to force Kate out of her shell but Kate wants her world to remain exactly as it is. Missing intimacy, James becomes close with Nicole, a cashier who is holding onto what's left of her youth while juggling single motherhood. When a new temp employee is hired, his presence shakes up the whole store, for all the wrong reasons.\", 'languages': ['English'], 'released': datetime.datetime(2014, 6, 23, 0, 0), 'directors': ['Gia Milani'], 'writers': ['Gia Milani'], 'awards': {'wins': 3, 'nominations': 1, 'text': '3 wins & 1 nomination.'}, 'lastupdated': '2015-09-07 00:22:06.433000000', 'year': 2013, 'imdb': {'rating': 6.1, 'votes': 416, 'id': 1568799}, 'countries': ['Canada'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.0, 'numReviews': 4}, 'production': 'National Theatre Live', 'lastUpdated': datetime.datetime(2015, 9, 17, 17, 0, 21)}, 'num_mflix_comments': 0}\n",
