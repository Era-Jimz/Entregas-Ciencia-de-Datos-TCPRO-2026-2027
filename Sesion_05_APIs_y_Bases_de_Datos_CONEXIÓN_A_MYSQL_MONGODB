            "{'_id': ObjectId('573a13dff29313caabdb78f6'), 'plot': \"'Life According to Sam' is about one family's courageous fight to save their only son from a rare and fatal disease, progeria. The average age of death from progeria is 13, there is no ...\", 'genres': ['Documentary', 'Biography', 'Drama'], 'runtime': 90, 'cast': ['Sam Berns'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjAwOTUyNDc4OF5BMl5BanBnXkFtZTcwMjg4NTM5OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Life According to Sam', 'fullplot': \"'Life According to Sam' is about one family's courageous fight to save their only son from a rare and fatal disease, progeria. The average age of death from progeria is 13, there is no treatment, and no cure. Dr. Leslie Gordon and Dr. Scott Berns are set on changing this. When their son Sam, now 16 years old, was diagnosed with progeria at age two, doctors told Leslie and Scott to enjoy Sam while they could. They refused to believe this was the answer. In less than a decade, their advances have led to identifying the gene at fault, creating the first drug trials for treatment, and revealing the amazing discovery that progeria is linked to the aging process in all of us.\", 'languages': ['English'], 'released': datetime.datetime(2013, 1, 21, 0, 0), 'directors': ['Sean Fine', 'Andrea Nix'], 'rated': 'TV-G', 'awards': {'wins': 3, 'nominations': 2, 'text': 'Won 1 Primetime Emmy. Another 2 wins & 2 nominations.'}, 'lastupdated': '2015-09-03 00:34:46.960000000', 'year': 2013, 'imdb': {'rating': 8.0, 'votes': 563, 'id': 2558550}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.hbo.com/documentaries/life-according-to-sam', 'viewer': {'rating': 4.3, 'numReviews': 133}, 'critic': {'rating': 6.5, 'numReviews': 7, 'meter': 100}, 'lastUpdated': datetime.datetime(2015, 7, 21, 19, 36, 38), 'rotten': 0, 'production': 'HBO Documentary Films', 'fresh': 7}, 'num_mflix_comments': 0}\n",
