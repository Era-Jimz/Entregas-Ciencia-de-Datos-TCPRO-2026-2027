            "{'_id': ObjectId('573a13f9f29313caabdeb0d7'), 'plot': 'The all-powerful Monkey King once roamed freely between Heaven and Earth, but after angering the Gods, he was imprisoned within an ice cage deep within the mountains. 500 years later, ...', 'genres': ['Animation'], 'runtime': 89, 'cast': ['Feodor Chin', 'Nika Futterman', 'James Hong', 'David S. Jung'], 'title': 'Monkey King: Hero Is Back', 'fullplot': 'The all-powerful Monkey King once roamed freely between Heaven and Earth, but after angering the Gods, he was imprisoned within an ice cage deep within the mountains. 500 years later, monsters attack a small village and a child flees to the mountains. Unknowingly, the child releases the Monkey King from his curse. With the help and encouragement from this special child, Monkey King saves the village from the evil monsters.', 'languages': ['English'], 'released': datetime.datetime(2015, 7, 10, 0, 0), 'directors': ['Tian Xiao Peng'], 'writers': ['Cory Edwards (creative consultant)', 'Tian Xiao Peng', 'Stephanie Sheh (english adaptation)'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-04 00:19:09.960000000', 'year': 2015, 'imdb': {'rating': 7.8, 'votes': 699, 'id': 4644382}, 'countries': ['China'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13faf29313caabdec1f8'), 'plot': 'An African-German Author looses his memory and is used by a modern National Socialist Party as promotion-figure for more political power over Germany.', 'genres': ['Comedy'], 'runtime': 102, 'cast': ['Oliver Baumgarten', 'Bernd Begemann', 'Ruth Bickelhaupt', 'Oliver Brècker'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjEyNzg0MDI2Nl5BMl5BanBnXkFtZTgwNTY5OTI5NTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Heil', 'fullplot': 'The African-German writer Sebastian Klein is one of the most famous Author of Germany. To promote his latest book, he is on reading-tour through Germany and also visits the little city of Prittwitz. But there, the local Neo-Nazis give him a hit on his head and Sebastian looses his memories. Instead he is parroting everything other people tell him. Sven, the political leader of a modern National Socialist Party, recognizing the opportunity and uses Sebastian as a promotion speaker against integration. When Sebastians highly pregnant girlfriend Nina is seeing him on TV, she is shocked and starts to chase him with the policeman Sascha in order to safe him from the Neo Nazis.', 'languages': ['German'], 'released': datetime.datetime(2015, 7, 16, 0, 0), 'directors': ['Dietrich Brèggemann'], 'writers': ['Dietrich Brèggemann'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-05 00:42:40.667000000', 'year': 2015, 'imdb': {'rating': 5.3, 'votes': 142, 'id': 4711952}, 'countries': ['Germany'], 'type': 'movie'}\n",
