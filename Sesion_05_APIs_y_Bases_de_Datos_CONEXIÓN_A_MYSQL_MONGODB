            "{'_id': ObjectId('573a13f5f29313caabde2db9'), 'plot': 'On her first day in Afghanistan, an interpreter for the US Army is forced to deliver the child of an enemy bomb-maker.', 'genres': ['Short', 'Drama', 'War'], 'runtime': 25, 'cast': ['Layla Alizada', 'Navid Negahban', 'Alexia Pearl', 'Bill Zasadil'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTQxNzMyNzI1OV5BMl5BanBnXkFtZTgwMjc4MDYwMzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Day One', 'fullplot': \"Inspired by a true story, an Afghan-American woman on the heels of a divorce joins the US Military as an interpreter. On her first day of deployment in Afghanistan, her unit searches out the remote house of a bomb-maker. When the bomb-maker's pregnant wife goes into labor, the interpreter must go beyond the call of duty to deliver her breech child.\", 'languages': ['English', 'Dari'], 'released': datetime.datetime(2015, 4, 16, 0, 0), 'directors': ['Henry Hughes'], 'writers': ['Dawn DeVoe (story)', 'Henry Hughes (story)', 'Henry Hughes', 'Henry Hughes'], 'awards': {'wins': 2, 'nominations': 0, 'text': '2 wins.'}, 'lastupdated': '2015-06-17 18:42:27.423000000', 'year': 2015, 'imdb': {'rating': '', 'votes': '', 'id': 4122886}, 'countries': ['USA'], 'type': 'movie', 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13f4f29313caabde2b2d'), 'plot': 'Film adaptation of acclaimed play, directed by one of the most exciting names in Polish contemporary theater. The main protagonists represent three generations of women living together ...', 'genres': ['Comedy', 'Drama'], 'runtime': 70, 'cast': ['Roma Gasiorowska', 'Magdalena Kuta', 'Lech Lotocki', 'Rafal Mackowiak'], 'num_mflix_comments': 0, 'title': 'Miedzy nami dobrze jest', 'fullplot': \"Film adaptation of acclaimed play, directed by one of the most exciting names in Polish contemporary theater. The main protagonists represent three generations of women living together below the minimum social level in a cramped Warsaw bedsitter, are: wheelchair-bound grandma, her daughter and granddaughter - little metal girl. The panorama of characters is complemented by their neighbors: a leaflet distributor and a highbrow director of the film 'Horse that rode horseback'. As well as, two actors, a TV presenter and a girl who wants to rescue all kinds of 'poor' people. A story full of grotesque dialogues comprised of perversely taken pop-culture quotes, mockery of the language of publicity and national stereotypes. All this, treating of post 1989 Polish society.\", 'languages': ['Polish'], 'released': datetime.datetime(2015, 1, 9, 0, 0), 'directors': ['Grzegorz Jarzyna'], 'writers': ['Grzegorz Jarzyna', 'Grzegorz Jarzyna', 'Dorota Maslowska (play)'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-22 00:11:10.767000000', 'year': 2014, 'imdb': {'rating': 7.2, 'votes': 25, 'id': 4112020}, 'countries': ['Poland'], 'type': 'movie'}\n",
