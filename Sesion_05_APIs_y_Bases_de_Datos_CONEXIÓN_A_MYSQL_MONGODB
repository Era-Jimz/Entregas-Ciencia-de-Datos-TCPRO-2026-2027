            "{'_id': ObjectId('573a13d3f29313caabd96a55'), 'plot': 'A teacher with paranormal abilities helps a group of ghosts graduate high school.', 'genres': ['Adventure', 'Comedy', 'Fantasy'], 'runtime': 88, 'rated': 'R', 'cast': ['Raèl Arèvalo', 'Alexandra Jimènez', 'Javier Bèdalo', 'Anna Castillo'], 'poster': 'https://m.media-amazon.com/images/M/MV5BZTAzOTQ3NjAtZWQwMC00ZGU1LThiMjYtYzMwY2EwN2M1NTRkXkEyXkFqcGdeQXVyMTY5MDE5NA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Ghost Graduation', 'fullplot': '\"The Sixth Sense\" meets \"The Breakfast Club\" when a teacher who sees dead people applies for work at a high school haunted by five student poltergeists who died during detention. All his life Modesto has seen dead people walking around like living people and has long accepted the assessment of others that he has a mental problem. Principal Tina Escalonilla turns that around when Modesto describes a detail (known to her) about the school spirits that no others have been able to reveal. With her school poised to be closed due to unrelenting paranormal high jinx, she begs Modesto to stay and see what he can do to ease these spirits into the next life before Founder\\'s Day.', 'languages': ['Spanish', 'English'], 'released': datetime.datetime(2013, 8, 1, 0, 0), 'directors': ['Javier Ruiz Caldera'], 'writers': ['Cristèbal Garrido (screenplay)', 'Adolfo Valor (screenplay)'], 'awards': {'wins': 3, 'nominations': 1, 'text': '3 wins & 1 nomination.'}, 'lastupdated': '2015-09-01 00:52:20.663000000', 'year': 2012, 'imdb': {'rating': 6.3, 'votes': 2037, 'id': 1924273}, 'countries': ['Spain'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 0.0, 'numReviews': 2}, 'lastUpdated': datetime.datetime(2015, 7, 25, 18, 16, 12)}, 'num_mflix_comments': 0}\n",
