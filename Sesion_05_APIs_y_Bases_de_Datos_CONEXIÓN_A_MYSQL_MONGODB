            "{'_id': ObjectId('573a13c8f29313caabd76d88'), 'plot': 'When a series of package bombs show up on the doorsteps of prominent politicians and businessmen in the summer of 1919, U.S. Bureau of Investigation Agent William Flynn (Strathairn) is ...', 'genres': ['Crime', 'Drama', 'History'], 'runtime': 94, 'metacritic': 48, 'rated': 'PG-13', 'cast': ['David Strathairn', 'Ray Wise', 'Sam Witwer', 'Alessandro Mario'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjM4NDgxNzEzOV5BMl5BanBnXkFtZTgwMDIxODMyMTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'No God, No Master', 'fullplot': 'When a series of package bombs show up on the doorsteps of prominent politicians and businessmen in the summer of 1919, U.S. Bureau of Investigation Agent William Flynn (Strathairn) is assigned the task of finding those responsible. He becomes immersed in an investigation that uncovers an anarchist plot to destroy democracy. Inspired by true events of the 20s the film sets the stage for a timely thriller with resoundingly similar parallels to the contemporary war on terrorism and the role government plays to defeat it.', 'languages': ['English'], 'released': datetime.datetime(2015, 10, 23, 0, 0), 'directors': ['Terry Green'], 'writers': ['Terry Green'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-31 00:14:29.390000000', 'year': 2013, 'imdb': {'rating': 5.9, 'votes': 456, 'id': 1485761}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://nogodnomasterthemovie.net/', 'viewer': {'rating': 3.3, 'numReviews': 279, 'meter': 47}, 'dvd': datetime.datetime(2014, 5, 19, 0, 0), 'critic': {'rating': 5.8, 'numReviews': 14, 'meter': 71}, 'boxOffice': '$6.8k', 'rotten': 4, 'production': 'Monterey Media Inc.', 'lastUpdated': datetime.datetime(2015, 9, 15, 17, 8, 57), 'fresh': 10}, 'num_mflix_comments': 0}\n",
