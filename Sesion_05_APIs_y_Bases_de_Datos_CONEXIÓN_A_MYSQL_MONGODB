            "{'_id': ObjectId('573a13d4f29313caabd98387'), 'plot': 'A clash between Sultan (a Qureishi dacoit chief) and Shahid Khan (a Pathan who impersonates him) leads to the expulsion of Khan from Wasseypur, and ignites a deadly blood feud spanning three generations.', 'genres': ['Action', 'Crime', 'Drama'], 'runtime': 320, 'metacritic': 89, 'cast': ['Manoj Bajpayee', 'Richa Chadda', 'Nawazuddin Siddiqui', 'Tigmanshu Dhulia'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTc5NjY4MjUwNF5BMl5BanBnXkFtZTgwODM3NzM5MzE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Gangs of Wasseypur', 'fullplot': \"Shahid Khan is exiled after impersonating the legendary Sultana Daku in order to rob British trains. Now outcast, Shahid becomes a worker at Ramadhir Singh's colliery, only to spur a revenge battle that passes on to generations. At the turn of the decade, Shahid's son, the philandering Sardar Khan vows to get his father's honor back, becoming the most feared man of Wasseypur.\", 'languages': ['Hindi'], 'released': datetime.datetime(2012, 8, 2, 0, 0), 'directors': ['Anurag Kashyap'], 'writers': ['Akhilesh Jaiswal', 'Anurag Kashyap', 'Sachin K. Ladia', 'Zeishan Quadri'], 'awards': {'wins': 10, 'nominations': 32, 'text': '10 wins & 32 nominations.'}, 'lastupdated': '2015-08-19 00:19:48.483000000', 'year': 2012, 'imdb': {'rating': 8.4, 'votes': 35127, 'id': 1954470}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'website': 'http://www.wasseypurworld.com/', 'viewer': {'rating': 4.3, 'numReviews': 1471, 'meter': 91}, 'critic': {'rating': 8.5, 'numReviews': 19, 'meter': 95}, 'lastUpdated': datetime.datetime(2015, 8, 24, 18, 16, 31), 'rotten': 1, 'fresh': 18}, 'num_mflix_comments': 0}\n",
