            "{'_id': ObjectId('573a13dcf29313caabdb0f44'), 'plot': '12-year-old Eli finds himself at summer CAMP.', 'genres': ['Drama'], 'runtime': 109, 'rated': 'PG-13', 'cast': ['Miles Elliot', 'Betsy Roth', 'Josh Berry', 'Michael Mattera'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjE2NDgzMjcxM15BMl5BanBnXkFtZTcwMTc3NzQxOQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Camp', 'fullplot': \"To impress a potential client, financial advisor Ken Matthews signs up to be a counselor at a camp for kids in the foster system. He is paired with Eli, a 10 year-old determined to hate camp. However, when Ken discovers Eli's dark past, his apathy turns to compassion. But is he to late to help the scared boy nobody wants? Inspired by true stories of ordinary people providing extraordinary help for abused and neglected kids, CAMP is a tale of hope shining in the dark places for forgotten children. For his performance in the role of Eli, actor Miles Elliot won BEST PERFORMANCE IN A FEATURE FILM by a Leading Young Actor at the 35th annual Young Artist Awards.\", 'languages': ['English'], 'released': datetime.datetime(2013, 2, 22, 0, 0), 'directors': ['Jacob Roebuck'], 'writers': ['Johnston Moore (additional writer)', 'Jacob Roebuck', 'Kristin Wolven (additional writer)'], 'awards': {'wins': 1, 'nominations': 1, 'text': '1 win & 1 nomination.'}, 'lastupdated': '2015-08-20 00:03:18.033000000', 'year': 2013, 'imdb': {'rating': 6.7, 'votes': 542, 'id': 2371287}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.0, 'numReviews': 344, 'meter': 78}, 'website': 'http://www.facebook.com/campmovie', 'production': 'Freestyle Releasing', 'boxOffice': '$0.3M', 'lastUpdated': datetime.datetime(2015, 8, 15, 19, 6, 15)}}\n",
            "{'_id': ObjectId('573a13dcf29313caabdb15aa'), 'plot': \"What happens to us when people stop acting like they're supposed to? A nurse gets into a dispute at work because she switches to speaking English when she gets nervous. A translator ...\", 'genres': ['Comedy', 'Drama'], 'runtime': 118, 'cast': ['Laila Goody', 'Ragnhild Hilt', 'Andrea Brèin Hovig', 'Anne Marit Jacobsen'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTcwMjI2MDc0OF5BMl5BanBnXkFtZTcwMTUwNzY4OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'I Belong', 'fullplot': \"What happens to us when people stop acting like they're supposed to? A nurse gets into a dispute at work because she switches to speaking English when she gets nervous. A translator compromises her integrity when persuaded to translate a book she doesn't believe in. An elderly woman and her daughter are humiliated when offered a present of one million kroner from a relative. I Belong is a warm and nuanced film about people who all mean well, but end up hurting one another. About how people who act on integrity and feelings are seen as troublesome in a society where the ideal is to behave rationally. A playful tragedy-comedy about how what seems like something of little importance to one person, can seem like a grand disaster to another.\", 'languages': ['Norwegian'], 'released': datetime.datetime(2012, 9, 14, 0, 0), 'directors': ['Dag Johan Haugerud'], 'writers': ['Dag Johan Haugerud'], 'awards': {'wins': 4, 'nominations': 6, 'text': '4 wins & 6 nominations.'}, 'lastupdated': '2015-09-03 00:39:55.773000000', 'year': 2012, 'imdb': {'rating': 6.7, 'votes': 403, 'id': 2377396}, 'countries': ['Norway'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.0, 'numReviews': 13}, 'lastUpdated': datetime.datetime(2015, 8, 4, 18, 17, 16)}, 'num_mflix_comments': 0}\n",
            "{'_id': ObjectId('573a13dcf29313caabdb1526'), 'plot': \"Todd and Bruce, a hapless screenwriting team, get one last shot at success thanks to Todd's wealthy uncle, Sarge. If they pen a worthy horror script, Sarge will fund the entire project. But...\", 'genres': ['Comedy', 'Horror', 'Thriller'], 'runtime': 83, 'cast': ['Mike Kopera', 'Bo Keister', 'Angela Relucio', 'Melissa Mars'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTU3OTU5NzAzOV5BMl5BanBnXkFtZTgwODIwNDQ4MjE@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Cabining', 'fullplot': \"Todd and Bruce, a hapless screenwriting team, get one last shot at success thanks to Todd's wealthy uncle, Sarge. If they pen a worthy horror script, Sarge will fund the entire project. But there is one condition - the script must be complete in two weeks. With the deadline looming and no fresh ideas, Todd and Bruce head to Shangri-La, a serene artist's retreat, with the hope that the peace and company of fellow artists will inspire greatness... or, failing greatness, at least enough for straight-to-DVD. Shangri-La proves to be anything but serene, as the artists die off one by one, seemingly by accident. Bruce convinces Todd to soak in this morbid atmosphere to help with the writing, but soon those two are fighting for their lives as well.\", 'languages': ['English'], 'released': datetime.datetime(2015, 1, 16, 0, 0), 'directors': ['Steve Kopera'], 'writers': ['Steve Kopera', 'David Silverman (storyline consultant)'], 'awards': {'wins': 6, 'nominations': 6, 'text': '6 wins & 6 nominations.'}, 'lastupdated': '2015-08-02 00:06:12.340000000', 'year': 2014, 'imdb': {'rating': 6.0, 'votes': 95, 'id': 2376440}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 1.3, 'numReviews': 9, 'meter': 0}, 'dvd': datetime.datetime(2014, 12, 9, 0, 0), 'website': 'http://www.indicanpictures.com/indicanpictures/cabining-the', 'production': 'Indican Pictures', 'lastUpdated': datetime.datetime