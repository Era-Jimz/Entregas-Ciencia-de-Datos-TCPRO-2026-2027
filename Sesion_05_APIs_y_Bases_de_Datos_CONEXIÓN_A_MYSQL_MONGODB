            "{'_id': ObjectId('573a13d3f29313caabd96e43'), 'plot': \"Featuring stunning footage from seven winters in the Arctic, People of a Feather takes you through time into the world of the Inuit on the Belcher Islands in Canada's Hudson Bay. Connecting...\", 'genres': ['Documentary'], 'runtime': 90, 'title': 'People of a Feather', 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjE4NTk3Njk3MV5BMl5BanBnXkFtZTcwNzcxMDU0Nw@@._V1_SY1000_SX677_AL_.jpg', 'countries': ['Canada'], 'fullplot': \"Featuring stunning footage from seven winters in the Arctic, People of a Feather takes you through time into the world of the Inuit on the Belcher Islands in Canada's Hudson Bay. Connecting past, present and future is a unique relationship with the eider duck. Eider down, the warmest feather in the world, allows both Inuit and bird to survive harsh Arctic winters. Traditional life is juxtaposed with modern challenges as both Inuit and eiders confront changing sea ice and ocean currents disrupted by the massive hydroelectric dams powering New York and eastern North America. Inspired by Inuit ingenuity and the technology of a simple feather, the film is a call to action to implement energy solutions that work with nature.\", 'languages': ['English', 'Inuktitut'], 'released': datetime.datetime(2013, 11, 8, 0, 0), 'directors': ['Joel Heath'], 'writers': ['Joel Heath', 'Dinah Kavik', 'Johnny Kudluarok', 'Community of Sanikiluaq'], 'awards': {'wins': 7, 'nominations': 6, 'text': '7 wins & 6 nominations.'}, 'lastupdated': '2015-08-04 01:03:22.833000000', 'year': 2011, 'imdb': {'rating': 7.9, 'votes': 77, 'id': 1929346}, 'type': 'movie', 'tomatoes': {'website': 'http://www.peopleofafeather.com', 'viewer': {'rating': 4.0, 'numReviews': 133, 'meter': 85}, 'dvd': datetime.datetime(2014, 2, 4, 0, 0), 'critic': {'rating': 6.7, 'numReviews': 7, 'meter': 86}, 'boxOffice': '$5.7k', 'rotten': 1, 'production': 'First Run Features', 'lastUpdated': datetime.datetime(201