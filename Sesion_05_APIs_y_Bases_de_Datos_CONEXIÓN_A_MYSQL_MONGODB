            "{'_id': ObjectId('573a13dcf29313caabdb1aa6'), 'plot': \"An examination of America's obesity epidemic and the food industry's role in aggravating it.\", 'genres': ['Documentary'], 'runtime': 92, 'metacritic': 71, 'rated': 'PG', 'cast': ['Oprah Winfrey', 'Bill Clinton', 'Michele Simon', 'Gary Taubes'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMjExMzk0NTU3NF5BMl5BanBnXkFtZTgwMjg5NTg1MTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Fed Up', 'fullplot': \"Upending the conventional wisdom of why we gain weight and how to lose it, Fed Up unearths a dirty secret of the American food industry-far more of us get sick from what we eat than anyone has previously realized. Filmmaker Stephanie Soechtig and TV journalist Katie Couric lead us through this potent exposè that uncovers why-despite media attention, the public's fascination with appearance, and government policies to combat childhood obesity-generations of American children will now live shorter lives than their parents did.\", 'languages': ['English'], 'released': datetime.datetime(2014, 1, 19, 0, 0), 'directors': ['Stephanie Soechtig'], 'writers': ['Mark Monroe', 'Stephanie Soechtig'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-31 00:51:05.437000000', 'year': 2014, 'imdb': {'rating': 7.7, 'votes': 5717, 'id': 2381335}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://fedupmovie.com/', 'viewer': {'rating': 4.0, 'numReviews': 11594, 'meter': 84}, 'dvd': datetime.datetime(2014, 9, 7, 0, 0), 'critic': {'rating': 7.1, 'numReviews': 63, 'meter': 81}, 'boxOffice': '$1.5M', 'consensus': 'Compelling and troubling in equal measure, Fed Up is an advocacy documentary that earns its outrage.', 'rotten': 12, 'production': 'Radius-TWC', 'lastUpdated': datetime.datetime(2015, 9, 12, 18, 4, 53), 'fresh': 51}, 'num_mflix_comments': 0}\n",
