            "{'_id': ObjectId('573a13eff29313caabdd7401'), 'plot': 'James is all too eager to put his one-minute time machine to use in winning the heart of Regina, until he discovers the unexpected consequences of his actions.', 'genres': ['Short', 'Comedy', 'Romance'], 'runtime': 6, 'cast': ['Brian Dietzen', 'Erinn Hayes'], 'num_mflix_comments': 2, 'poster': 'https://m.media-amazon.com/images/M/MV5BMjg0OTI1NTA4NV5BMl5BanBnXkFtZTgwNDA0MzU1MTE@._V1_SY1000_SX677_AL_.jpg', 'title': 'One-Minute Time Machine', 'fullplot': \"James is feeling rather proud of his little technological marvel that allows him to travel back in time precisely one minute. It's the perfect tool for trying to seduce the beautiful Regina who is sitting on a park bench, enjoying the sun. If he makes a mistake or receives a rejection, he just hits the little red button and tries again. Unfortunately for James, he learns that his machine hasn't been working the way he thought, and he must now face the dark reality of his actions.\", 'languages': ['English'], 'released': datetime.datetime(2014, 3, 29, 0, 0), 'directors': ['Devon Avery'], 'writers': ['Sean Crouch', 'Sean Crouch'], 'awards': {'wins': 7, 'nominations': 3, 'text': '7 wins & 3 nominations.'}, 'lastupdated': '2015-08-14 00:00:19.707000000', 'year': 2014, 'imdb': {'rating': 8.2, 'votes': 236, 'id': 3620860}, 'countries': ['UK', 'USA'], 'type': 'movie'}\n",
            "{'_id': ObjectId('573a13eff29313caabdd77d0'), 'plot': 'A family on a ski holiday in the French Alps find themselves staring down an avalanche during lunch one day; in the aftermath, their dynamic has been shaken to its core, with a question mark hanging over their patriarch in particular.', 'genres': ['Drama'], 'runtime': 120, 'metacritic': 87, 'rated': 'R', 'cast': ['Johannes Kuhnke', 'Lisa Loven Kongsli', 'Vincent Wettergren', 'Clara Wettergren'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BNmEwMDlmOTAtNGE1NC00ZjA2LWExYzUtYWY2N2E1MmI3MjgwXkEyXkFqcGdeQXVyMTMxODk2OTU@._V1_SY1000_SX677_AL_.jpg', 'title': 'Force Majeure', 'fullplot': \"A Swedish family travels to the French Alps to enjoy a few days of skiing. The sun is shining and the slopes are spectacular but, during a lunch at a mountainside restaurant, an avalanche turns everything upside down. With diners fleeing in all directions, mother Ebba calls for her husband Tomas as she tries to protect their children. Tomas, meanwhile, is running for his life... The anticipated disaster failed to occur, and yet the family's world has been shaken to its core, a question mark hanging over their father in particular. Tomas and Ebba's marriage now hangs in the balance as Tomas struggles desperately to reclaim his role as family patriarch.\", 'languages': ['Swedish', 'English', 'French', 'Norwegian'], 'released': datetime.datetime(2014, 12, 30, 0, 0), 'directors': ['Ruben èstlund'], 'writers': ['Ruben èstlund'], 'awards': {'wins': 31, 'nominations': 26, 'text': 'Nominated for 1 Golden Globe. Another 30 wins & 26 nominations.'}, 'lastupdated': '2015-09-06 00:40:01.993000000', 'year': 2014, 'imdb': {'rating': 7.4, 'votes': 20880, 'id': 3630276}, 'countries': ['Sweden', 'France', 'Norway', 'Denmark'], 'type': 'movie'}\n",
