            "{'_id': ObjectId('573a13def29313caabdb6652'), 'plot': 'Rosenwald, by Aviva Kempner, is a documentary about how Chicago philanthropist Julius Rosenwald, the son of an immigrant peddler who rose to head Sears, partnered with Booker T. Washington ...', 'genres': ['Documentary', 'Biography'], 'runtime': 100, 'metacritic': 68, 'cast': ['Peter Ascoli', 'Julian Bond', 'Stephanie Deutsch', 'Richard J. Powell'], 'title': 'Rosenwald', 'fullplot': 'Rosenwald, by Aviva Kempner, is a documentary about how Chicago philanthropist Julius Rosenwald, the son of an immigrant peddler who rose to head Sears, partnered with Booker T. Washington to build 5,400 Southern schools in African American communities in the early 1900s during the Jim Crow era. Rosenwald also built YMCAs and housing for African Americans to address the pressing needs of the Great Migration. The Rosenwald Fund supported great artists like Marian Anderson, Woody Guthrie, Langston Hughes, Gordon Parks, and Jacob Lawrence. Among those interviewed are civil rights leaders Julian Bond, Ben Jealous and Congressman John Lewis, columnists Eugene Robinson and Clarence Page, Cokie Roberts, Rabbi David Saperstein, Rosenwald school alumni writer Maya Angelou and director George C. Wolfe and Rosenwald relatives.', 'languages': ['English'], 'released': datetime.datetime(2015, 8, 14, 0, 0), 'directors': ['Aviva Kempner'], 'writers': ['Aviva Kempner'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-08-31 00:23:19.340000000', 'year': 2015, 'imdb': {'rating': 7.8, 'votes': 12, 'id': 2514028}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://www.rosenwaldfilm.org/', 'viewer': {'rating': 5.0, 'numReviews': 72}, 'critic': {'rating': 8.0, 'numReviews': 6, 'meter': 83}, 'lastUpdated': datetime.datetime(2015, 8, 16, 18, 1, 1), 'rotten': 1, 'production': 'Ciesla Foundation', 'fresh': 5}, 'num_mflix_comments': 0}\n",
