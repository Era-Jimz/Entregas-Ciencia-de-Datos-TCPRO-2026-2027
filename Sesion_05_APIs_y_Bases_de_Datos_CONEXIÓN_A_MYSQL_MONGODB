            "{'_id': ObjectId('573a13ddf29313caabdb37b2'), 'plot': \"An all-new Disney holiday classic is born - Santa Paws 2: The Santa Pups. Starring a brand-new litter of the cutest talking pups ever - Hope, Jingle, Charity, and Noble - it's perfect for ...\", 'genres': ['Adventure', 'Family'], 'runtime': 88, 'rated': 'G', 'cast': ['Cheryl Ladd', 'Danny Woodburn', 'Kaitlyn Maher', 'Pat Finn'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTc1NzM5NTA4MF5BMl5BanBnXkFtZTcwNjU5MjQ3OA@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Santa Paws 2: The Santa Pups', 'fullplot': \"An all-new Disney holiday classic is born - Santa Paws 2: The Santa Pups. Starring a brand-new litter of the cutest talking pups ever - Hope, Jingle, Charity, and Noble - it's perfect for the whole family. When Mrs. Claus travels to Pineville, the playful Santa Pups stow away on her sled. Taking mischief to a whole new level, they begin granting joyful wishes to Pineville's boys and girls, but something goes terribly wrong - the Christmas spirit begins to disappear. Now the Santa Pups and Mrs. Claus must race to save Christmas around the world. From the creators of Disney Buddies, this magical, heartwarming tale is brimming with hope, cheer, and Christmas spirit.\", 'languages': ['English'], 'released': datetime.datetime(2012, 11, 20, 0, 0), 'directors': ['Robert Vince'], 'writers': ['Philip Fracassi', 'Anna McRoberts', 'Robert Vince'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-10 17:51:54.587000000', 'year': 2012, 'imdb': {'rating': 4.9, 'votes': 601, 'id': 2414212}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 3.6, 'numReviews': 77, 'meter': 64}, 'dvd': datetime.datetime(2012, 11, 20, 0, 0), 'lastUpdated': datetime.datetime(2015, 9, 12, 17, 12, 24)}, 'num_mflix_comments': 0}\n",
