            "{'_id': ObjectId('573a13cbf29313caabd7ec9f'), 'plot': \"When a woman tries to outwit her husband's sexy young mistress, the unexpected consequences include starring as King Lear in a very amateur production - with the mistress, an aspiring actress, playing The Fool.\", 'genres': ['Comedy', 'Drama'], 'runtime': 115, 'metacritic': 28, 'rated': 'R', 'cast': ['Marcia Gay Harden', 'Leonor Watling', 'Joseph Kell', 'Daniela Saioni'], 'poster': 'https://m.media-amazon.com/images/M/MV5BMTY4MDcxMjk2NF5BMl5BanBnXkFtZTcwMzg3NjAxOQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'If I Were You', 'fullplot': \"Two women who meet by chance make a pact to fix their unhappy lives: they will each do what the other one says. But one of them has a secret. She knows her husband is sleeping with the younger woman. Madelyn's plan backfires when Lucy, an aspiring actress, orders her to play King Lear in a very amateur production, with Lucy playing the Fool. Madelyn's life is transformed in unexpected ways as, like Lear, she struggles with matters of mortality and betrayal, loyalty and love.\", 'languages': ['English'], 'released': datetime.datetime(2012, 1, 10, 0, 0), 'directors': ['Joan Carr-Wiggin'], 'writers': ['Joan Carr-Wiggin'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-08-14 00:14:02.020000000', 'year': 2012, 'imdb': {'rating': 7.0, 'votes': 1047, 'id': 1587309}, 'countries': ['Canada', 'UK'], 'type': 'movie', 'num_mflix_comments': 0}\n",
