            "{'_id': ObjectId('573a13cdf29313caabd85d6f'), 'plot': \"When a notorious criminal is forced to return to London, it gives a detective one last chance to take down the man he's always been after.\", 'genres': ['Action', 'Crime', 'Thriller'], 'runtime': 99, 'metacritic': 49, 'rated': 'R', 'cast': ['James McAvoy', 'Mark Strong', 'Andrea Riseborough', 'Johnny Harris'], 'poster': 'https://m.media-amazon.com/images/M/MV5BODkwNjY1MjUzOF5BMl5BanBnXkFtZTcwOTU0NDAyOQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Welcome to the Punch', 'fullplot': 'Former criminal Jacob Sternwood is forced to return to London from his Icelandic hideaway when his son is involved in a heist gone wrong. This gives detective Max Lewinsky one last chance to catch the man he has always been after. As they face off, they start to uncover a deeper conspiracy they both need to solve in order to survive.', 'languages': ['English'], 'released': datetime.datetime(2013, 3, 15, 0, 0), 'directors': ['Eran Creevy'], 'writers': ['Eran Creevy'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2015-09-06 00:06:24.573000000', 'year': 2013, 'imdb': {'rating': 6.1, 'votes': 24651, 'id': 1684233}, 'countries': ['UK', 'USA'], 'type': 'movie', 'tomatoes': {'website': 'http://cinemapurgatorio.com/movies/axe-giant-the-wrath-of-paul-bunyan', 'viewer': {'rating': 1.9, 'numReviews': 225, 'meter': 16}, 'dvd': datetime.datetime(2013, 6, 18, 0, 0), 'boxOffice': '$2.5k', 'production': 'Cinema Purgatorio', 'lastUpdated': datetime.datetime(2015, 8, 26, 18, 21, 24)}, 'num_mflix_comments': 0}\n",
