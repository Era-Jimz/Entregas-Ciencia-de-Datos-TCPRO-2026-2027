            "{'_id': ObjectId('573a13c7f29313caabd748e6'), 'plot': 'Set against a backdrop of war, religious strife and power struggles which tears lives and families apart.', 'genres': ['Drama', 'History', 'Romance'], 'runtime': 60, 'cast': ['Ian McShane', 'Matthew Macfadyen', 'Eddie Redmayne', 'Hayley Atwell'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTg3NDgwNjQ4MV5BMl5BanBnXkFtZTcwMzU5MjI2Mw@@._V1_SY1000_SX677_AL_.jpg', 'title': 'The Pillars of the Earth', 'fullplot': \"The Pillars of the Earth is set against a backdrop of war, religious strife and power struggles which tears lives and families apart. In that time, there rises a magnificent Cathedral in Kingsbridge. Against the backdrop, love-stories entwine: Tom, the master builder, Aliena, the noblewoman, the sadistic Lord William, Philip, the prior of Kingsbridge, Jack, the artist in stone work and Ellen, the woman from the forest who casts a curse. At once, this is a sensuous and enduring love story and an epic that shines with the fierce spirit of a passionate age. Follett masterfully weaves these stories through political turmoil of 12th century England, creating a relevant and viable world for today's audience and for generations to come.\", 'languages': ['English'], 'released': datetime.datetime(2010, 7, 23, 0, 0), 'rated': 'TV-MA', 'awards': {'wins': 7, 'nominations': 18, 'text': 'Nominated for 3 Golden Globes. Another 4 wins & 18 nominations.'}, 'lastupdated': '2015-09-15 05:15:46.230000000', 'year': 2010, 'imdb': {'rating': 8.2, 'votes': 20130, 'id': 1453159}, 'countries': ['Germany', 'Canada', 'UK'], 'type': 'series', 'tomatoes': {'viewer': {'rating': 3.5, 'numReviews': 9, 'meter': 50}, 'lastUpdated': datetime.datetime(2015, 9, 16, 18, 15, 24)}}\n",
            "{'_id': ObjectId('573a13c7f29313caabd744bb'), 'plot': 'The story of the New York accent, as told by New Yorkers.', 'genres': ['Documentary', 'Biography', 'Comedy'], 'runtime': 55, 'cast': ['Penny Marshall', 'Amy Heckerling', 'Pat Cooper', 'Pete Hamill'], 'num_mflix_comments': 1, 'title': 'If These Knishes Could Talk: The Story of the NY Accent', 'fullplot': 'From Atlantic Ave. to Zerega Ave., word on the street is the New York accent is disappearing -- a casualty of a city that\\'s evolved into a vast expanse of banks, H&Ms and glass-blown high-rises. But even though you may not hear \"toity-toid and toid\" in Manhattan, you can still hear strains in Bensonhurst, Whitestone or Tottenville. Or you can have a look-see through our film. We\\'ve gathered some accent experts, official and non, to weigh in on what it means to tawk the talk in a city that may be slowly trying to quiet the noise.', 'languages': ['English'], 'released': datetime.datetime(2013, 5, 16, 0, 0), 'directors': ['Heather Quinlan'], 'writers': ['Heather Quinlan', 'Richard Svinkin'], 'awards': {'wins': 1, 'nominations': 0, 'text': '1 win.'}, 'lastupdated': '2014-10-20 00:46:06.043000000', 'year': 2013, 'imdb': {'rating': 7.3, 'votes': 6, 'id': 1449183}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'website': 'http://disney.go.com/pooh/home/', 'viewer': {'rating': 3.9, 'numReviews': 35840, 'meter': 80}, 'dvd': datetime.datetime(2011, 10, 25, 0, 0), 'critic': {'rating': 7.2, 'numReviews': 126, 'meter': 90}, 'boxOffice': '$26.7M', 'consensus': 'Short, nostalgic, and gently whimsical, Winnie the Pooh offers young audiences -- and their parents -- a sweetly traditional family treat.', 'rotten': 12, 'production': 'Walt Disney Pictures', 'lastUpdated': datetime.datetime(2015, 9, 14, 17, 55, 19), 'fresh': 114}}\n",
