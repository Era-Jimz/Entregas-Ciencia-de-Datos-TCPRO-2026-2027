            "{'_id': ObjectId('573a13e5f29313caabdc2efe'), 'plot': 'Two codependent roommates, on the verge of eviction, flee New York for the promise of sunshine in Los Angeles where their friendship is tested by a chance at fame, a fortune teller and an amorous wealthy aunt.', 'genres': ['Comedy', 'Drama'], 'runtime': 95, 'cast': ['Jess Weixler', 'Jennifer Prediger', 'Megan Mullally', 'Will Forte'], 'num_mflix_comments': 0, 'poster': 'https://m.media-amazon.com/images/M/MV5BNDEyNjYxNjczMV5BMl5BanBnXkFtZTgwODcxODY2NDE@._V1_SY1000_SX677_AL_.jpg', 'title': 'Apartment Troubles', 'fullplot': 'This comedy follows two codependent East Village, New York girls, Olivia and Nicole, on the verge of eviction and existential crisis. They\\'re struggling artists, living in a Bohemian apartment. Their electricity has been turned off and they\\'ve begun an ill-advised juice fast. To top it all off, they\\'re out of money and too \"talented\" to come up with the rent. To solve their problems they go to L.A. to visit Nicole\\'s wealthy aunt, Kimberley, the host of a popular reality TV talent show. As Kimberley convinces the girls to audition, the girls struggle to maintain their friendship as Olivia begins to realize she may not be as dependent on Nicole as she once believed.', 'languages': ['English'], 'released': datetime.datetime(2015, 3, 27, 0, 0), 'directors': ['Jennifer Prediger', 'Jess Weixler'], 'writers': ['Jennifer Prediger', 'Jess Weixler'], 'awards': {'wins': 0, 'nominations': 1, 'text': '1 nomination.'}, 'lastupdated': '2015-09-11 00:15:29.997000000', 'year': 2014, 'imdb': {'rating': 4.3, 'votes': 217, 'id': 2977110}, 'countries': ['USA'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 2.6, 'numReviews': 27}, 'website': 'http://www.gravitasventures.com/apartment-troubles/', 'lastUpdated': datetime.datetime(2015, 8, 19, 19, 7, 5)}}\n",
            "{'_id': ObjectId('573a13e5f29313caabdc34cb'), 'plot': 'A story about the hair-raising minefield between love, attraction and commitment.', 'genres': ['Comedy', 'Drama', 'Romance'], 'runtime': 141, 'cast': ['Sushant Singh Rajput', 'Parineeti Chopra', 'Vaani Kapoor', 'Rishi Kapoor'], 'num_mflix_comments': 1, 'poster': 'https://m.media-amazon.com/images/M/MV5BMTU0NjI2MTI0Ml5BMl5BanBnXkFtZTcwNjI4MzY5OQ@@._V1_SY1000_SX677_AL_.jpg', 'title': 'Shuddh Desi Romance', 'fullplot': \"What happens when three young people in today's changing India try to figure out what love, attraction and commitment mean to each of them? Raghu (Shushant Singh Rajput) needs a woman in his life -the rest he's going to figure out along the way. Gayatri (Parineeti Chopra) has been around the block a few times and knows the scene, warts and all. Tara (Vaani Kapoor) knows what's right for her, but a little experimenting never did hurt anybody, did it? When their lives crisscross, their beliefs get challenged, and their loves, tested. We all want it all...the love, the sex, the relationship, the commitment. But when we get it, it may not be in the way we recognize.\", 'languages': ['Hindi'], 'released': datetime.datetime(2013, 9, 6, 0, 0), 'directors': ['Maneesh Sharma'], 'writers': ['Jaideep Sahni'], 'awards': {'wins': 5, 'nominations': 17, 'text': '5 wins & 17 nominations.'}, 'lastupdated': '2015-09-11 00:07:00.617000000', 'year': 2013, 'imdb': {'rating': 5.8, 'votes': 4355, 'id': 2988272}, 'countries': ['India'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 2.9, 'numReviews': 465, 'meter': 39}, 'website': 'http://www.facebook.com/shuddhdesiromance', 'production': 'Yash Raj Films', 'lastUpdated': datetime.datetime(2015, 9, 13, 10, 40, 26)}}\n",
            "{'_id': ObjectId('573a13e5f29313caabdc3629'), 'plot': \"A taxi driver who lives in Napoli spend his time on his uncle's car thinking about happiness. His former brother took a road for happiness practicing Buddhism while he is always sad and ...\", 'genres': ['Animation', 'Drama'], 'runtime': 82, 'cast': ['Leandro Amato', 'Nando Paone', 'Renato Carpentieri', 'Jun Ichikawa'], 'num_mflix_comments': 1, 'title': \"L'arte della felicitè\", 'fullplot': \"A taxi driver who lives in Napoli spend his time on his uncle's car thinking about happiness. His former brother took a road for happiness practicing Buddhism while he is always sad and melancholic. He listens to a radioshow called the art of happiness as a remembering idea of what is the goal of life. Do we have just one life or are we living again and again forever?\", 'languages': ['Italian', 'Neapolitan', 'English'], 'released': datetime.datetime(2013, 11, 21, 0, 0), 'directors': ['Alessandro Rak'], 'writers': ['Alessandro Rak (screenplay)', 'Luciano Stella (screenplay)', 'Nicola Barile (story)', 'Alessandro Rak (story)', 'Luciano Stella (story)', 'Paola Tortora (story)'], 'awards': {'wins': 5, 'nominations': 3, 'text': '5 wins & 3 nominations.'}, 'lastupdated': '2015-08-16 00:17:18.337000000', 'year': 2013, 'imdb': {'rating': 7.2, 'votes': 260, 'id': 2990836}, 'countries': ['Italy'], 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.2, 'numReviews': 13}, 'lastUpdated': datetime.datetime(2015, 7, 29, 19, 3, 58)}}\n",
            "{'_id': ObjectId('573a13e5f29313caabdc33f5'), 'plot': \"'9-Man' is an independent feature documentary about an isolated and exceptionally athletic Chinese-American sport that's much more than a pastime. Since the 1930s, young men have played ...\", 'genres': ['Documentary', 'History', 'Sport'], 'runtime': 89, 'title': '9-Man', 'num_mflix_comments': 1, 'countries': ['USA', 'China', 'Canada'], 'fullplot': \"'9-Man' is an independent feature documentary about an isolated and exceptionally athletic Chinese-American sport that's much more than a pastime. Since the 1930s, young men have played this gritty streetball game competitively in the alleys and parking lots of Chinatown. At a time when anti-Chinese sentiment and laws like the Chinese Exclusion Act forced Chinese restaurant workers and laundrymen to socialize exclusively amongst themselves, nine-man offered both escape and fraternity for men who were separated from their families in China and facing extreme discrimination and distrust. Pivoting between oil-spotted Chinatown parking lots and jellyfish-filled banquet scenes, the film captures the spirit of nine-man as players not only battle for a championship but fight to preserve a sport that holds so much history.\", 'languages': ['English', 'Chinese'], 'released': datetime.datetime(2014, 4, 27, 0, 0), 'directors': ['Ursula Liang'], 'awards': {'wins': 3, 'nominations': 2, 'text': '3 wins & 2 nominations.'}, 'lastupdated': '2015-08-18 01:10:24.377000000', 'year': 2014, 'imdb': {'rating': 7.7, 'votes': 17, 'id': 2986300}, 'type': 'movie', 'tomatoes': {'viewer': {'rating': 4.8, 'numReviews': 10}, 'website': 'http://www.9-man.com/', 'lastUpdated': datetime.datetime(2015, 5, 10, 18, 35, 44)}}\n",
